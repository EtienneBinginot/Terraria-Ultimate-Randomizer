Keybinds: {
	Debug.DisplayName: Open the randomizer debug panel
	Journal.DisplayName: Open the randomizer journal
}

Debug: {
	Title: Ultimate Randomizer - debug
	NeedWorld: Load a world first.
	SinglePlayerOnly: This action only works in single player.
	TabOverview: Overview
	TabInspector: Inspector
	TabTools: Tools
	TabTests: Tests
	On: on
	Off: off
	Seed: Seed
	Mode: Mode
	Network: Game
	SinglePlayer: single player
	Multiplayer: multiplayer
	Tier: Unlocked tier
	Limit: Max allowed tier
	Gating: Lock
	Pool: Items randomizable / protected / excluded
	Snapshots: Drop tables enemies / bags
	Findable: Found from tier {0}, obtainable (with crafting) from tier {1}
	GuaranteedOn: Guaranteed drop of: {0}
	GuaranteedTag: (guaranteed)
	Individual: "{0}: health x{1}, damage x{2}, defense x{3}, size x{4}; loot bonus x{5}"
	KindNormal: Normal
	KindGiant: Giant
	KindMini: Mini
	Swaps: Swaps
	SwapStats: "{0} flagged: {1} enemies and {2} critters swapped; {3} not swappable, {4} kept by chance, {5} without a replacement"
	Recipes: Recipes
	Shimmer: Shimmer
	Chests: Chests
	SetTier: Set progression (boss flags) to tier:
	NewSeed: New random seed
	PoolTable: Items per category, tiers 0 to 9:
	TierSet: Progression set to {0}.
	SeedSet: New seed: {0}.
	HoverItem: Item under the mouse (or held)
	NoItem: Hover an item or hold one.
	ItemInfo: Category {0}, tier {1} ({2}), protected {3}, excluded {4}, stack {5}-{6}, value {7}
	ShufflePartner: Guaranteed shuffle partner: {0}
	NearestNpc: NPC nearest to the mouse
	NoNpc: No NPC near the mouse.
	NpcTier: tier {0} (rolls: {1})
	Multipliers: Multipliers: life x{0}, damage x{1}, defense x{2}, size x{3}
	Swappable: Can be replaced by the random enemies feature.
	NotSwappable: Never replaced by the random enemies feature.
	Drops: Drops in this world:
	NoDrops: Drops nothing in this world.
	ExtraTag: (extra)
	ConditionTag: (conditions)
	Player: Player
	GodMode: Invincible
	SpawnRate: Spawns
	SpawnRateNormal: normal
	SpawnRateNone: none
	SpawnRateHigh: many
	ToggleGodMode: Invincible on/off
	CycleSpawnRate: Spawn rate
	GiveKit: Test kit
	World: World
	Day: day
	Night: night
	SpawnEnemies: Spawn 5 enemies
	KillHostiles: Kill enemies on screen
	ToggleDay: Day/night
	GiveBags: All boss bags
	OpenJournal: Journal
	ToolsHelp: Tip: Inspector tab + mouse over an enemy shows its drops; kill it to compare. Spawned enemies spawn like natural ones (random enemies apply).
	RunTests: Run all tests
	TestsHelp: Runs every automated test in the current world. Results also go to client.log.
	TestSummary: "{0} passed, {1} failed, {2} skipped"
}

Tests: {
	NoWorld: World loaded
	PoolBuilt: Item pool built, every main category has items
	Classification: Known items are classified correctly
	Determinism: Rolls are deterministic and depend on the seed
	GatingRespected: No item above the allowed tier (progression lock)
	NoProtectedRolled: Protected and excluded items are never given at random
	SameCategory: Replacements keep the category
	ShuffleBijection: Guaranteed shuffle: every obtainable item is given exactly once
	StackRules: Stack sizes are valid
	PriceFloor: Shop prices are never below the item value
	DropRates: Drop rates are valid
	SnapshotsCaptured: Original drop tables were read
	MobPlansValid: Every enemy drop table is valid
	ProtectedDropsKept: Progression drops are kept
	NoMinionFarms: Boss minions and town NPCs get no random drops
	EventItemsKept: Old One's Army items and boss segments are handled
	SwapSurvivesVariantSetDefaults: Enemy variants (Pinky, zombie variants) are still swapped
	CritterSwapLive: Critters really get swapped, in the same habitat
	CritterPoolSafe: No gold critter, Prismatic Lacewing, Truffle Worm or lava critter can appear in place of another
	CritterHabitat: Water, flying and ground critters stay in their habitat
	SwapStatsCount: Natural spawns are counted, statue spawns are left alone
	SurpriseZero: With 0% surprise, replaced items keep their category
	SurpriseHundred: With 100% surprise, categories follow the loot weights
	SurpriseGatedAndProtected: Surprises respect progression and protected items
	RecipeSurpriseRate: The share of recipes changing category matches the setting
	WeightTablesSeparated: Loot weights favor equipment, ingredient weights never pick it
	TierWindowVariety: Early random rolls give many different items
	OreMappingBijective: Each ore of this world still exists, as the drop of exactly one other ore of the world; absent ores stay themselves, and deciding a hardmode pair changes no ore of another tier; one-to-one even with both ores of a pair present
	TreeShakeReplacement: Shaken trees give random items and keep acorns
	HerbReplacementTable: Each herb has a fixed set of valid replacements
	ExtractinatorRules: The Extractinator keeps coins and swaps ores for ores
	AnglerRewardsValid: Angler rewards are replaced by valid items, coins kept
	TreeCritterSwap: Critters falling from trees are swapped too
	PacingExpected: 15 to 25 pieces of random equipment per early hour (default settings; the value is written to client.log)
	PacingSimulation: The pacing simulation is stable and regular
	PacingVariety: At least 10 different pieces of equipment per early hour
	DropFrequency: Most kills give something (at least 0.6 items per kill; the value is written to client.log)
	WorkBenchPacing: The first work bench comes after 15 to 30 minutes on average (written to client.log)
	BasicStationsUnprotected: Basic stations (work bench, furnace, anvil...) are left to the randomizer
	ProgressionStationsProtected: Progression stations (Hellforge, hardmode anvils and forges...) stay protected
	BasicStationsFindable: Every basic station can be found at the start (enemies and pots)
	GuaranteedReachability: Every guaranteed item is carried by natural enemies of its tier
	GuaranteedLoadBalanced: No enemy carries too many guaranteed items
	GuaranteedHostsNotEvents: Guaranteed drops are never on invasion, moon, seasonal or weather enemies
	GuaranteedDeterminism: Guaranteed sources are the same after a rebuild
	FindabilityDeterminism: Findability of items is the same after a rebuild
	WorldMaterialsFindable: Wood, stone, gems and early ores are findable from the start
	BagContentFindable: Bag contents count as found only once the bag can be obtained (never seasonal bags, treasure bags only in expert mode)
	CrateAccessWorld: Crates the world cannot give (other evil, pre-hardmode Hallowed crate) are no source
	HardmodeOresOfWorld: Hardmode pair ores always count as findable and are never new ingredients
	AltarDecisionKeepsCaches: An altar choosing a hardmode ore changes neither the guaranteed sources nor findability
	IngredientReplacementsFindable: Replaced ingredients are found (not crafted) by the recipe's level
	RecipesDoable: At least 85% of the randomized recipes can be made at their level
	AvailabilityConsistent: The planned item availability matches an independent recomputation over the applied recipes
	NoSelfIngredient: No recipe uses its own result
	ResultNotInGroup: No randomized recipe gives an item its own ingredient group accepts
	IngredientValueCoherent: Replaced ingredients keep about the same value
	ProtectedIngredientsKept: Protected ingredients (progression materials...) are never replaced
	RecipeGroupsSane: Every recipe group (any wood, any iron bar...) still has its ingredient
	RecipePlanDeterminism: Ingredients and stations are the same after a rebuild
	UntouchedRecipesIntact: Protected recipes keep their ingredients and stations
	DecraftSafeWithIngredients: Shimmer decrafting never gives back more valuable ingredients
	VanillaModeGuaranteed: In vanilla ingredient mode, every missing ingredient is placed on enemies
	StationDag: No crafting station needs itself to be made, directly or through other stations
	StationTierRespected: Recipes never need a station above their level, nor a themed one
	HandCraftKept: Recipes made by hand stay made by hand
	StationsVaried: A good share of recipes changed station
	AppliedResultsMatchPlan: Recipes give the results the planner was built around, and its availability matches the live recipes
	StationPlanFromOriginals: The station plan depends only on the original recipes, not on the already randomized ones
	RealCrafting: The crafting menu offers a recipe with its new ingredients, and no longer with its old ones
	PickaxePerMiningLevel: Each mining level has a pickaxe by the tier of its ores (crafted, found or guaranteed)
	RecipeRandomizationShare: Most vanilla recipes change their result (85%) or their result or ingredients (95%); logs the reasons
	RecipeValueFallback: The value fallback gives an item of the original's category and tier, affordable or else the cheapest
	CraftedValueFromIngredients: An item crafted through a randomized recipe sells for at most its ingredients, through saves, network, splits and stacks
	FurnitureSurprise: Furniture, block and wall recipes give something else with the furniture surprise chance
	ProtectedRecipesDoable: Recipes making progression stations and protected items can be made at their level
	BellCurveShape: Enemy stats are bell-shaped: mostly normal, a few % far from it
	BellCurveBounds: Rolled stats always stay inside their range
	ExtremenessEffect: The rarity setting makes extreme values rarer
	GiantMiniFrequency: Giants and minis appear as often as set
	GiantMiniBounds: Giant and mini sizes stay inside their range
	GiantHitboxCap: Giants never exceed the largest allowed size
	IndividualSyncRoundTrip: Individual stats (giant, mini...) reach multiplayer clients intact
	ClientIndividualLife: Giants and minis have the right maximum health on multiplayer clients, without resetting their synced health
	NoGiantMinions: Boss minions are never giants or minis and never give the giant bonus drop
	TransformRerollsIndividual: Swapped enemies get their own individual stats
	VariantGetsIndividual: An enemy turned into a variant (Pinky...) keeps its own individual stats and health ratio
	TransformKeepsIndividual: A vanilla transformation keeps the enemy's individual stats (no giant flicker) and its health ratio
	StatCacheBossFlag: Boss multipliers do not depend on an earlier lookup of the same type as a non-boss
	LootBonusCap: The loot bonus grows with strength and stays under its cap
	LootBonusApplied: Stronger enemies get a loot bonus
	BagPlansValid: Every bag content is valid
	BagsKeepCoins: Boss bags keep their coins
	RecipesSafe: Recipes: no self-ingredient, value guard respected
	MiningProtected: Pickaxe and bar recipes are unchanged
	DecraftSafe: Shimmer decrafting can't duplicate items
	ShimmerCoherent: Shimmer transformations keep category and value
	ShopSimulation: Simulated shop: no duplicates, fair prices, special slots untouched
	EnemySwapPool: Random enemies: no boss parts, minions or event enemies
	EnemySwapDaylight: Random enemies: nothing that flees daylight by day
	TownOrderPermutation: Town NPC order is a valid permutation
	EnemyStatRanges: Boss multipliers stay in the configured range
	ConfigTexts: Every setting has a text
	OtherTexts: Every message has a text
	ConfigRanges: Settings are consistent
	CacheSignatureScope: Saving an enemy stat setting keeps findability and the recipe plan; loot and swap pool settings rebuild them
}

Journal: {
	Title: Randomizer journal
	Monsters: Monsters
	Bags: Bags
	Empty: Nothing discovered yet: kill monsters and open bags!
	Tier: tier {0}
	Description: Opens the randomizer journal (also the J key)
}

Chat: {
	ConfigHostOnly: Only the host can change the Ultimate Randomizer settings.
	OldRandomizerEnabled: "[Ultimate Randomizer] tRandomizer is enabled too: loot is randomized twice. Enable only one of the two randomizers in Manage Mods."
	StartingKit: Ultimate Randomizer: you received a random starting kit for this world!
}

Commands: {
	Seed: {
		Description: Shows or changes the randomizer seed of this world
		Show: World randomizer seed: {0}
		Changed: World seed changed to {0}: everything is randomized again.
		NotAllowed: Only the host can change the seed, and only if allowed in the config.
	}

	Debug: {
		Description: Randomizer debug information
		NotFound: Not found: {0}
		Item: "{0}: {1}, tier {2} ({3}), protected: {4}, excluded: {5}, stack {6}-{7}"
		Npc: "{0}: tier {1} (used for rolls: {2})"
		Tier: Unlocked tier: {0} ({1})
		PoolLogged: The item pool was written to client.log.
		RecipesOff: Recipes are not randomized in this world.
		NoDrops: This enemy drops nothing in this world.
	}

	Chests: {
		Description: Randomizes the natural chests of a world created without the mod
		AlreadyDone: Chests are already randomized in this world.
		Warning: This randomizes once the natural chests of this world. Chests with a name, and chests near the spawn point or town NPC houses (probably yours) are skipped. Type /rchests confirm to proceed.
		Done: "{0} chests randomized."
	}
}

