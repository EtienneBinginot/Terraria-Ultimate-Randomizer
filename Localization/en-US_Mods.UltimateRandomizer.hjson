	GeneralConfig: {
		DisplayName: 1. General

		Headers: {
			Mode: Mode
			Seed: Seed
			Exclusions: Exclusions
		}

		RandomizerMode: {
			Label: Randomizer mode
			Tooltip:
				'''
				Chaos: anything can come from anywhere (like the original tRandomizer).
				Coherent: random, but categories and tiers are respected and items unlock with progression.
				Guaranteed shuffle: every item is swapped with another of the same category and tier, so everything stays obtainable.
				'''
		}

		SeedSource: {
			Label: Seed of new worlds
			Tooltip:
				'''
				Random: each world gets its own random seed.
				From the world seed: two worlds created with the same seed get the same randomization.
				Fixed: every new world uses the fixed seed below.
				'''
		}

		FixedSeed: {
			Label: Fixed seed
			Tooltip: Used when the seed source is Fixed.
		}

		AllowSeedChange: {
			Label: Allow /rseed to change the seed
			Tooltip: Lets the host (or the single player) change the seed of the current world with /rseed set or /rseed random.
		}

		ExcludedItems: {
			Label: Excluded items
			Tooltip: These items are never randomized and never given as a random item.
		}

		ExcludedMods: {
			Label: Excluded mods
			Tooltip: Internal names of mods whose items are left out of the randomizer (for example CalamityMod).
		}

		ResetAll: {
			Label: Reset all settings (click twice)
			Tooltip: Puts every setting of Ultimate Randomizer (all pages, client settings included) back to its default value. Click, then click again within a few seconds to confirm. In a world, the settings that need a reload are kept: reset from the main menu to reset them too. In multiplayer, only the host can do it.
		}
	}

	ProgressionConfig: {
		DisplayName: 2. Progression and protection

		Headers: {
			TierGating: Unlocking items with progression
			Protection: Protected progression items
			Tiers: Tiers
			Guarantees: Guaranteed sources
			AdaptivePower: Adaptive power
		}

		TierGating: {
			Label: Lock items behind progression
			Tooltip:
				'''
				Items of a tier not unlocked yet (bosses defeated) are replaced by an item of the highest allowed tier,
				until you progress. Prevents getting the Zenith from the first slime.
				'''
		}

		TierAllowance: {
			Label: Tiers allowed above your progression
			Tooltip: 0 = only tiers already unlocked. 1 = one tier ahead (default), and so on. Before hardmode, nothing from hardmode is given except jackpots. Adaptive power makes enemies stronger if your equipment gets ahead of the world.
		}

		JackpotTierChance: {
			Label: Jackpot chance (%)
			Tooltip: Chance for a drop slot to aim 2 or 3 tiers higher than normal. It still respects the progression lock.
		}

		RuntimeJackpotChance: {
			Label: Lucky drop chance (%)
			Tooltip: Chance, on each kill, to ignore the progression lock and get the real item right away. Above the limit, it is a jackpot: always useful equipment or a crafting station, shown with light and sound. Weak enemies (less health than usual at their level) get a smaller chance, critters and enemies spawned by another enemy none.
		}

		WildDropChance: {
			Label: Madness: drops above the limit (%)
			Tooltip: Share of the random drops of enemies and bags that go above the progression limit, at any time. Each tier further above is rarer (see the next setting): an early Zenith is possible, but extremely rare. These jackpots are always useful (equipment, progression stations), shown brighter the higher they are, and not listed among the enemy's drops. Enemies then adapt to your equipment (adaptive power). Weak enemies get a smaller share, critters and enemies spawned by another enemy none. 0 = classic progression.
		}

		WildTierDecay: {
			Label: Jackpots: rarity per extra tier
			Tooltip: How much rarer each tier above the limit is for jackpots (madness and lucky drops): 3 (default) = one tier above is 3 times more frequent than two tiers above. There is no cap: an early hardmode item is possible, but rare. Higher = jackpots stay closer to the limit.
		}

		MechTierRequiresAllThree: {
			Label: Mechanical tier needs the three mechanical bosses
			Tooltip: Off: one mechanical boss is enough to unlock the tier.
		}

		ScaleWeakEnemiesWithProgression: {
			Label: Weak enemies follow your progression
			Tooltip: On: early enemies drop items close to your current tier instead of staying at their own level.
		}

		AdaptivePower: {
			Label: Enemies adapt to your equipment
			Tooltip: Strong items may come early, but then enemies and bosses get stronger: every tier of power above the world's progression multiplies their health and damage when they spawn (bosses are measured again during the fight). Enemies never get weaker. Power = best weapon carried, inventory and Void Vault (50%), armor (25%) and 3 best accessories (25%), the best of the worn ones and of the loadouts.
		}

		AdaptiveGrace: {
			Label: Free tiers of power
			Tooltip: Tiers of power above your progression that do not make enemies stronger yet.
		}

		LifeGrowthPerTier: {
			Label: Enemy health per tier of power
			Tooltip: Enemy health multiplier for each tier of power too many (multiplied again for each tier).
		}

		DamageGrowthPerTier: {
			Label: Enemy damage per tier of power
			Tooltip: Enemy damage multiplier for each tier of power too many (multiplied again for each tier). Kept low on purpose: defense is subtracted from damage, so health does most of the scaling.
		}

		BossLifeGrowthPerTier: {
			Label: Boss health per tier of power
			Tooltip: Same for bosses and their parts, which answer to the strongest player.
		}

		BossDamageGrowthPerTier: {
			Label: Boss damage per tier of power
			Tooltip: Same for the damage of bosses, their parts and their projectiles.
		}

		AdaptiveCap: {
			Label: Maximum health multiplier
			Tooltip: Enemy health is never multiplied by more than this by adaptive power.
		}

		AdaptiveDamageCap: {
			Label: Maximum damage multiplier
			Tooltip: Enemy damage is never multiplied by more than this by adaptive power (the total damage cap of the enemy settings applies too).
		}

		ProtectedItems: {
			Label: Protected items
			Tooltip: Never replaced (drops, recipes...) and never given as a random item. Empty by default: boss summons, the Pwnhammer and the Temple Key are randomized and dropped by common enemies of their tier instead (reset the list to get the new default).
		}

		ProtectProgressionMaterials: {
			Label: Protect progression materials
			Tooltip: On: Shadow Scales, Tissue Samples, Hallowed Bars, mechanical souls, lunar fragments, Luminite, Ectoplasm and biome keys are never randomized. Off (default): they are; recipes still need a key of their tier, and Luminite, mechanical souls or Ectoplasm never drop before their tier.
		}

		AutoProtectBossSummons: {
			Label: Protect all boss summons
			Tooltip: Off: boss summons (crafted, dropped, or found in the world: Truffle Worm, Lihzahrd Power Cell, Gelatin Crystal, Prismatic Lacewing) are randomized and dropped by common enemies of their tier instead; the critters can still be caught. The summons of other mods stay protected. On: every boss summon is protected.
		}

		StationProtection: {
			Label: Crafting station protection
			Tooltip: None: every station is randomized, progression ones too (Hellforge, hardmode anvils and forges, Tinkerer's Workshop, Ancient Manipulator...): each one gets a random recipe doable at its tier and a guardian, a common enemy of its tier that sometimes drops it. Progression only: only basic stations (work bench, furnace, anvil, table, chair, sawmill, loom...) are randomized that way. A station of another mod that many recipes need stays protected; the others are treated like the themed stations (Glass Kiln, Bone Welder...).
		}

		GuaranteedDropMultiplier: {
			Label: Guaranteed drop chance multiplier
			Tooltip: Boss summons and pickaxes (and vanilla ingredients, if chosen) are placed on the common enemies of one biome of their tier. Raise this to find them sooner. Station guardians have their own chance.
		}

		StationGuardianChance: {
			Label: Station guardian drop chance (%)
			Tooltip: With randomized recipes, each crafting station has a random recipe doable at its tier (the Guide tells it) and one guardian: a common enemy of its tier that drops it with this chance per kill (shared between players), ten times less often once anyone has obtained that station in the world. A boss guarding a late station always drops it. Pots and chests never give stations.
		}

		GuaranteedHostsPerItem: {
			Label: Enemies carrying each guaranteed item
			Tooltip: Each guaranteed item (stations, boss summons, pickaxes, needed ingredients) is placed on the enemies of one biome of its tier, the most frequent first, up to this many. The hints name them all.
		}

		StationFindKills: {
			Label: Kills in its biome to find a summon or pickaxe
			Tooltip: Average number of kills in its biome before a guaranteed boss summon or pickaxe drops, all its enemies together. Crafting stations come from their recipe, or from their guardian (see the guardian chance); with recipes not randomized, the unprotected progression stations are found this way too.
		}

		PotGuaranteeChance: {
			Label: Guaranteed items in pots (%)
			Tooltip: Chance that a pot also gives one of the guaranteed items already unlocked that nobody has found yet in this world.
		}

		ScaleGuaranteesWithPlayers: {
			Label: Guaranteed drops shared between players
			Tooltip: In multiplayer, the chance of a guaranteed station, boss summon or pickaxe on each kill is divided by the number of players: the team finds it about as fast as one player alone, not several copies of it.
		}

		MinFindableChance: {
			Label: Minimum chance to count as findable (%)
			Tooltip: A drop counts as a way to find an item (to choose recipe ingredients) when its chance is at least this.
		}

		TierOverrides: {
			Label: Tier overrides
			Tooltip: Forces the tier of specific items (useful for items from other mods).
		}
	}

	TierOverride: {
		Tooltip: ""

		Item: {
			Label: Item
			Tooltip: ""
		}

		Tier: {
			Label: Tier
			Tooltip: ""
		}
	}

	LootConfig: {
		DisplayName: 3. Loot

		Headers: {
			Mobs: Enemies and bosses
			Bags: Bags and crates
			World: World: chests, fishing, mining
			Variety: Variety
		}

		RandomizeMobDrops: {
			Label: Randomize enemy and boss drops
			Tooltip: Each item an enemy drops is replaced by an item of the same category, with the original chance and conditions (or, in the permutation style, moved to another enemy of the same level). Progression items, coins and treasure bags are kept.
		}

		DropTableStyle: {
			Label: Enemy drop style
			Tooltip: Permutation (default): the original drops of the enemies are shuffled between enemies of the same level; each item keeps its own chance and stack, and takes the conditions of the enemy receiving it. A few of them become surprises (see below). Enemies without any drop get one random drop of their level, shuffled with the others. Every enemy also gets a few random extra drops with vanilla-like rates (see below). Vanilla-like: the original drops are replaced, and each enemy type gets a random number of extra drops (usually few, sometimes many) with vanilla-like rates (1/1 for materials, 1/50 for equipment...). Simple: replaced drops, and every extra slot has the fixed chance below. Mirror of the original: no extra drops, only the original drops (replaced). Bosses of the same level also shuffle their drops between them (treasure bags follow their boss), with the same few extra drops, the first one always dropped.
		}

		PermutationExtraSlots: {
			Label: Extra drops per enemy (permutation)
			Tooltip: Permutation style only: number of random extra drops every enemy gets on top of its shuffled original drops, with vanilla-like rates (1/1 to 1/10 for potions and ammo, 1/15 to 1/150 for equipment...) multiplied by the drop rate multiplier, and higher while some of the enemy's drops are still locked by progression. Loot abundance does not change them. 0 = none.
		}

		PermutationExtraWeights: {
			Label: Extra drop weights (permutation)
			Tooltip: Permutation style only: relative chance of each kind of item for the random extra drops. 0 = never. By default no materials, ores or bars: the shuffled original drops already give plenty.
		}

		PermutationSurpriseChance: {
			Label: Surprise drops (permutation, %)
			Tooltip: Permutation style only: share of the shuffled drops (except materials, ores and bars) that become a random item of the enemy's level, with the same conditions and the same chance (lower for a rare item: a frequent drop does not become a frequent weapon). Every item except blocks, critters and ores keeps one copy that is never replaced, so an item dropped by a single enemy always stays. Copies beyond the limits below always become surprises.
		}

		PermutationDuplicateCopies: {
			Label: Max copies per item (permutation)
			Tooltip: Permutation style only: vanilla gives the same item to many enemies (every zombie its Shackle and Zombie Arm, every slime its Slime Staff). An item (except materials, ores and bars) keeps at most this many shuffled copies, the most reachable ones; every other copy always becomes a surprise. Classic and Expert drops are counted apart. 0: no limit.
		}

		PermutationMaterialCopies: {
			Label: Max copies per material (permutation)
			Tooltip: Permutation style only: the same limit for materials (Gel, Lens...), so recipes still find them on several enemies. Ores and bars are never limited. 0: no limit.
		}

		EnemiesWithoutDropsCanDrop: {
			Label: Enemies without drops get extra drops
			Tooltip: Enemies that drop nothing in the base game also get extra random drops. Boss minions and parts never do.
		}

		CrittersCanDrop: {
			Label: Critters get random drops
			Tooltip: Bunnies, birds, butterflies, insects... get up to 2 extra random drops (more with loot abundance) and a share of the small frequent drop.
		}

		CritterDropFactor: {
			Label: Critter frequent drop share
			Tooltip: Share of the small frequent drop (material, potion, ammo...) that critters get, compared with other enemies. They come in swarms and die in one hit: 0.5 = half as often, 0 = never. In the permutation drop style, critters get the same random extra slots as enemies, each at this share of its chance, and their frequent drop has a chance of its own (Critter frequent drop chance).
		}

		CritterCommonDropChance: {
			Label: Critter frequent drop chance (permutation)
			Tooltip: Permutation drop style only: chance (%) per kill that a critter gives one small frequent drop (material, potion, ammo, food, block...), on top of its random extra slots. Never a jackpot. 0 = no frequent drop.
		}

		DropRateMultiplier: {
			Label: Drop rate multiplier
			Tooltip: Multiplies every drop chance (vanilla-like and mirror styles). 2 = twice as many drops.
		}

		DropSlotsMin: {
			Label: Extra drops (minimum)
			Tooltip: Number of possible extra drops of a normal enemy. Each enemy type gets its own fixed number in a world, usually close to the minimum.
		}

		DropSlotsMax: {
			Label: Extra drops (maximum)
			Tooltip: ""
		}

		DropChance: {
			Label: Drop chance of each slot (%)
			Tooltip: Only used by the Simple style. Items above the enemy's level are rarer.
		}

		CommonDropChance: {
			Label: Small frequent drop (%)
			Tooltip: Every enemy also has one small drop fixed for the world (material, potion, ammo, food, block or ore), with this chance. Most kills then give something.
		}

		LootAbundance: {
			Label: Loot abundance
			Tooltip: Scales the random drops of enemies: more extra drops, more often, and more small frequent drops (above 100 %, extra ones). 2 = about twice as many items per kill as 1; the default 3 gives about three times as many. Guaranteed drops (stations, progression items) are not affected.
		}

		BossDropSlotsMin: {
			Label: Boss extra drops (minimum)
			Tooltip: In expert and master mode, bosses with a treasure bag get no extra drops: their bag content is randomized instead.
		}

		BossDropSlotsMax: {
			Label: Boss extra drops (maximum)
			Tooltip: ""
		}

		DropCategoryWeights: {
			Label: Loot weights
			Tooltip: Relative chance of each kind of item for everything that gives random items (extra drops, surprises). 0 = never. Recipe ingredients use their own weights, except their surprise ingredients.
		}

		RandomizeBossBags: {
			Label: Randomize treasure bags
			Tooltip: Each item in the bag is replaced by an item of the same category and tier. With the permutation drop style, a boss bag holds the shuffled drops of its boss instead (and its extra drops).
		}

		RandomizeCrates: {
			Label: Randomize fishing crates
			Tooltip: ""
		}

		RandomizeOtherBags: {
			Label: Randomize other bags
			Tooltip: Goodie bags, presents, herb bags, geodes, cans of worms...
		}

		RandomizeChests: {
			Label: Randomize chests of new worlds
			Tooltip: Each item of a natural chest is replaced by an item of the same category, at world creation. For older worlds, use /rchests.
		}

		ChestTierBonus: {
			Label: Chest tier bonus
			Tooltip: Makes chest content this many tiers better.
		}

		JackpotChestChance: {
			Label: Jackpot chests (%)
			Tooltip: Share of the natural chests that become jackpot chests (at least 2 per world): 2 to 4 useful items above the chest's level (sometimes from hardmode), gold and potions. They shine with a beam of light until someone opens them. Placed with the chests, or once in a world whose chests were randomized before. 0 = none.
		}

		RandomizeFishing: {
			Label: Randomize fishing
			Tooltip: Each fish gives another item of the same category and tier. Quest fish are never changed.
		}

		CratesStayCrates: {
			Label: Crates stay crates
			Tooltip: Fished crates are not replaced (their content is randomized when opened).
		}

		RandomizeOreDrops: {
			Label: Randomize mined ores
			Tooltip: Each ore gives another ore or bar of the same tier (always the same one in a world).
		}

		RandomizePotDrops: {
			Label: Randomize pot loot
			Tooltip: Items from pots are replaced by items of the same category. Coins and hearts are unchanged.
		}

		RandomizeTreeShaking: {
			Label: Randomize shaken trees
			Tooltip: Fruits and items falling from shaken trees are replaced (same kind, or a surprise).
		}

		KeepAcorns: {
			Label: Keep acorns
			Tooltip: Shaken trees still give acorns, so trees can be replanted.
		}

		RandomizeHerbs: {
			Label: Randomize herbs and plants
			Tooltip: Herbs, mushrooms, jungle spores and other plants give other materials of their tier. Seeds are kept.
		}

		HerbKeepChance: {
			Label: Herbs kept (%)
			Tooltip: Chance that a herb or plant still gives its usual item.
		}

		HerbVariety: {
			Label: Items per herb
			Tooltip: Number of different items each herb or plant can turn into in a world.
		}

		RandomizeExtractinator: {
			Label: Randomize the Extractinator
			Tooltip: Items from the Extractinator are replaced (ores by other ores of the same tier). Coins are kept.
		}

		RandomizeAnglerRewards: {
			Label: Randomize Angler rewards
			Tooltip: Rewards of the Angler's fishing quests are replaced. Coins and bait are kept.
		}

		SurpriseChance: {
			Label: Surprise chance (%)
			Tooltip: Chance that a replaced item (enemy drop, chest, pot, bag, fish...) becomes an item of any category, rolled with the loot weights, instead of keeping its kind. 0 = always the same kind, 100 = anything.
		}

		TierWindow: {
			Label: Tier window
			Tooltip: Random items are also picked among this many tiers below the target. More variety, especially early in the game.
		}
	}

