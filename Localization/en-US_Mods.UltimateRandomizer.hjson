	EconomyConfig: {
		DisplayName: 4. Economy

		Headers: {
			Shops: Shops
			Stacks: Stack sizes
		}

		RandomizeShops: {
			Label: Randomize shops
			Tooltip: Each shop item is replaced by an item of the same category. It keeps the original item's unlock conditions.
		}

		PriceMultiplierMin: {
			Label: Price multiplier (minimum)
			Tooltip: Price = item value x a random multiplier. Never below 1, so buying and reselling never makes money.
		}

		PriceMultiplierMax: {
			Label: Price multiplier (maximum)
			Tooltip: ""
		}

		MinimumPrice: {
			Label: Minimum price (copper coins)
			Tooltip: 100 copper = 1 silver.
		}

		NoDuplicatesInShop: {
			Label: No duplicates in a shop
			Tooltip: ""
		}

		ShopsFollowProgression: {
			Label: Shops follow progression
			Tooltip: Shops sell better items as you defeat bosses.
		}

		StackCaps: {
			Label: Maximum stack per category
			Tooltip: Largest amount given at once. The item's own maximum stack still applies.
		}

		StackMultiplier: {
			Label: Stack multiplier
			Tooltip: Multiplies all the maximums above.
		}

		ValueBasedStacks: {
			Label: Keep the value of replaced items
			Tooltip: When an item replaces another, the amount is adjusted so the total value stays close to the original.
		}
	}

