	CraftingConfig: {
		DisplayName: "5. Crafting and shimmer"
		Headers: {
			Recipes: Recipes
			Shimmer: Shimmer
		}

		RandomizeRecipes: {
			Label: Randomize recipe results
			Tooltip: "Each recipe gives an item of the same category and tier as the original. Recipes go back to normal when you leave the world."
		}

		RecipeValueGuard: {
			Label: Value guard
			Tooltip: "A result can be worth at most this many times its ingredients. Prevents turning cheap ingredients into a fortune."
		}

		DisableDecraftOfRandomizedResults: {
			Label: No shimmer decrafting of random results
			Tooltip: "Prevents duplicating items by crafting a random result then decrafting it in shimmer."
		}

		RandomizeShimmer: {
			Label: Randomize shimmer transmutations
			Tooltip: "Each shimmer transformation gives another item of the same category and tier. Decrafting is not affected."
		}
	}

	EnemiesConfig: {
		DisplayName: "6. Enemies and bosses"
		Headers: {
			Bosses: Bosses
			Enemies: Normal enemies
		}

		RandomizeBossHealth: {
			Label: Randomize boss health
			Tooltip: "The normal health of each boss is multiplied by a random value between the minimum and maximum, fixed for the world. Expert and master bonuses apply on top."
		}

		BossHealthMin: {
			Label: Boss health: minimum multiplier
			Tooltip: "0.5 = half health."
		}

		BossHealthMax: {
			Label: Boss health: maximum multiplier
			Tooltip: "3 = triple health."
		}

		RandomizeBossDamage: {
			Label: Randomize boss damage
			Tooltip: "Contact damage only: projectiles keep their own damage."
		}

		BossDamageMin: {
			Label: Boss damage: minimum multiplier
			Tooltip: ""
		}

		BossDamageMax: {
			Label: Boss damage: maximum multiplier
			Tooltip: ""
		}

		RandomizeEnemyStats: {
			Label: Randomize normal enemies
			Tooltip: "Health, damage, defense and size of each enemy type are multiplied by random values fixed for the world."
		}

		EnemyHealthMin: {
			Label: Health: minimum multiplier
			Tooltip: ""
		}

		EnemyHealthMax: {
			Label: Health: maximum multiplier
			Tooltip: ""
		}

		EnemyDamageMin: {
			Label: Damage: minimum multiplier
			Tooltip: ""
		}

		EnemyDamageMax: {
			Label: Damage: maximum multiplier
			Tooltip: ""
		}

		EnemyDefenseMin: {
			Label: Defense: minimum multiplier
			Tooltip: ""
		}

		EnemyDefenseMax: {
			Label: Defense: maximum multiplier
			Tooltip: ""
		}

		EnemyScaleMin: {
			Label: Size: minimum multiplier
			Tooltip: "Changes the hitbox too. Large values can make enemies get stuck."
		}

		EnemyScaleMax: {
			Label: Size: maximum multiplier
			Tooltip: ""
		}
	}

