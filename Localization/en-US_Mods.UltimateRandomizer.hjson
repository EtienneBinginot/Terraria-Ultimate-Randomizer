	DropTableStyle: {
		Tooltip: ""

		VanillaLike: {
			Label: Vanilla-like
			Tooltip: ""
		}

		MirrorOriginal: {
			Label: Mirror of the original
			Tooltip: ""
		}

		Simple: {
			Label: Simple
			Tooltip: ""
		}
	}

	GeneralConfig: {
		DisplayName: 1. General

		Headers: {
			Mode: Mode
			Seed: Seed
			Exclusions: Exclusions
		}

		RandomizerMode: {
			Label: Randomizer mode
			Tooltip:
				'''
				Chaos: anything can come from anywhere (like the original tRandomizer).
				Coherent: random, but categories and tiers are respected and items unlock with progression.
				Guaranteed shuffle: every item is swapped with another of the same category and tier, so everything stays obtainable.
				'''
		}

		SeedSource: {
			Label: Seed of new worlds
			Tooltip:
				'''
				Random: each world gets its own random seed.
				From the world seed: two worlds created with the same seed get the same randomization.
				Fixed: every new world uses the fixed seed below.
				'''
		}

		FixedSeed: {
			Label: Fixed seed
			Tooltip: Used when the seed source is Fixed.
		}

		AllowSeedChange: {
			Label: Allow /rseed to change the seed
			Tooltip: Lets the host (or the single player) change the seed of the current world with /rseed set or /rseed random.
		}

		ExcludedItems: {
			Label: Excluded items
			Tooltip: These items are never randomized and never given as a random item.
		}

		ExcludedMods: {
			Label: Excluded mods
			Tooltip: Internal names of mods whose items are left out of the randomizer (for example CalamityMod).
		}
	}

	ProgressionConfig: {
		DisplayName: 2. Progression and protection

		Headers: {
			TierGating: Unlocking items with progression
			Protection: Protected progression items
			Tiers: Tiers
			Guarantees: Guaranteed sources
		}

		TierGating: {
			Label: Lock items behind progression
			Tooltip:
				'''
				Items of a tier not unlocked yet (bosses defeated) are replaced by an item of the highest allowed tier,
				until you progress. Prevents getting the Zenith from the first slime.
				'''
		}

		TierAllowance: {
			Label: Tiers allowed above your progression
			Tooltip: 0 = only tiers already unlocked. 1 = one tier ahead (default), and so on.
		}

		JackpotTierChance: {
			Label: Jackpot chance (%)
			Tooltip: Chance for a drop slot to aim 2 or 3 tiers higher than normal. It still respects the progression lock.
		}

		RuntimeJackpotChance: {
			Label: Lucky drop chance (%)
			Tooltip: Chance, on each kill, to ignore the progression lock and get the real item right away.
		}

		MechTierRequiresAllThree: {
			Label: Mechanical tier needs the three mechanical bosses
			Tooltip: Off: one mechanical boss is enough to unlock the tier.
		}

		ScaleWeakEnemiesWithProgression: {
			Label: Weak enemies follow your progression
			Tooltip: On: early enemies drop items close to your current tier instead of staying at their own level.
		}

		ProtectedItems: {
			Label: Protected items
			Tooltip: Never replaced (drops, recipes...) and never given as a random item. Keeps progression possible.
		}

		ProtectProgressionMaterials: {
			Label: Protect progression materials
			Tooltip: Shadow Scales, Tissue Samples, Hallowed Bars, mechanical souls, lunar fragments, Luminite, Ectoplasm and biome keys are never randomized.
		}

		AutoProtectBossSummons: {
			Label: Protect all boss summons
			Tooltip: Also protects boss summoning items from other mods.
		}

		StationProtection: {
			Label: Crafting station protection
			Tooltip: Progression only: basic stations (work bench, furnace, anvil, table, chair, sawmill, loom...) are no longer protected; they are found in the world (common enemies, pots, wooden chests). Progression stations (Hellforge, hardmode anvils and forges...) keep their recipe, even with None.
		}

		ProtectPickaxeProgression: {
			Label: "Protect the mining progression"
			Tooltip: "On: pickaxe and bar recipes are never randomized. Off: they are, and a pickaxe strong enough for each new ore is guaranteed on common enemies when the recipes don't give one in time. Mined ores only turn into other ores of the same tier."
		}

		GuaranteedDropMultiplier: {
			Label: Guaranteed drop chance multiplier
			Tooltip: Basic stations (and vanilla ingredients, if chosen) are placed on two common enemies of their tier. Raise this to find them sooner.
		}

		PotGuaranteeChance: {
			Label: Guaranteed items in pots (%)
			Tooltip: Chance that a pot also gives one of the guaranteed items already unlocked.
		}

		ChestStationGuarantee: {
			Label: Basic stations in wooden chests
			Tooltip: Copies of each basic station hidden in wooden chests when the world is created (or when /rchests is used).
		}

		MinFindableChance: {
			Label: Minimum chance to count as findable (%)
			Tooltip: A drop counts as a way to find an item (to choose recipe ingredients) when its chance is at least this.
		}

		TierOverrides: {
			Label: Tier overrides
			Tooltip: Forces the tier of specific items (useful for items from other mods).
		}
	}

	TierOverride: {
		Tooltip: ""

		Item: {
			Label: Item
			Tooltip: ""
		}

		Tier: {
			Label: Tier
			Tooltip: ""
		}
	}

	LootConfig: {
		DisplayName: 3. Loot

		Headers: {
			Mobs: Enemies and bosses
			Bags: Bags and crates
			World: World: chests, fishing, mining
			Variety: Variety
		}

		RandomizeMobDrops: {
			Label: Randomize enemy and boss drops
			Tooltip: Each item an enemy drops is replaced by an item of the same category, with the original chance and conditions. Progression items, coins and treasure bags are kept.
		}

		DropTableStyle: {
			Label: Extra drops
			Tooltip: On top of the replaced original drops. Vanilla-like: each enemy type gets a random number of extra drops (usually few, sometimes many) with vanilla-like rates (1/1 for materials, 1/50 for equipment...). Simple: every extra slot has the fixed chance below. Mirror of the original: no extra drops, only the original drops (replaced).
		}

		EnemiesWithoutDropsCanDrop: {
			Label: Enemies without drops get extra drops
			Tooltip: Enemies that drop nothing in the base game also get extra random drops. Boss minions and parts never do.
		}

		CrittersCanDrop: {
			Label: Critters get extra drops
			Tooltip: Bunnies, birds, butterflies, insects... get up to 2 extra random drops.
		}

		DropRateMultiplier: {
			Label: Drop rate multiplier
			Tooltip: Multiplies every drop chance (vanilla-like and mirror styles). 2 = twice as many drops.
		}

		DropSlotsMin: {
			Label: Extra drops (minimum)
			Tooltip: Number of possible extra drops of a normal enemy. Each enemy type gets its own fixed number in a world, usually close to the minimum.
		}

		DropSlotsMax: {
			Label: Extra drops (maximum)
			Tooltip: ""
		}

		DropChance: {
			Label: Drop chance of each slot (%)
			Tooltip: Only used by the Simple style. Items above the enemy's level are rarer.
		}

		CommonDropChance: {
			Label: "Small frequent drop (%)"
			Tooltip: "Every enemy also has one small drop fixed for the world (material, potion, ammo, food, block or ore), with this chance. Most kills then give something."
		}

		BossDropSlotsMin: {
			Label: Boss extra drops (minimum)
			Tooltip: In expert and master mode, bosses with a treasure bag get no extra drops: their bag content is randomized instead.
		}

		BossDropSlotsMax: {
			Label: Boss extra drops (maximum)
			Tooltip: ""
		}

		DropCategoryWeights: {
			Label: Loot weights
			Tooltip: Relative chance of each kind of item for everything that gives random items (extra drops, surprises). 0 = never. Ingredients of recipes use their own weights.
		}

		RandomizeBossBags: {
			Label: Randomize treasure bags
			Tooltip: Each item in the bag is replaced by an item of the same category and tier.
		}

		RandomizeCrates: {
			Label: Randomize fishing crates
			Tooltip: ""
		}

		RandomizeOtherBags: {
			Label: Randomize other bags
			Tooltip: Goodie bags, presents, herb bags, geodes, cans of worms...
		}

		RandomizeChests: {
			Label: Randomize chests of new worlds
			Tooltip: Each item of a natural chest is replaced by an item of the same category, at world creation. For older worlds, use /rchests.
		}

		ChestTierBonus: {
			Label: Chest tier bonus
			Tooltip: Makes chest content this many tiers better.
		}

		RandomizeFishing: {
			Label: Randomize fishing
			Tooltip: Each fish gives another item of the same category and tier. Quest fish are never changed.
		}

		CratesStayCrates: {
			Label: Crates stay crates
			Tooltip: Fished crates are not replaced (their content is randomized when opened).
		}

		RandomizeOreDrops: {
			Label: Randomize mined ores
			Tooltip: Each ore gives another ore or bar of the same tier (always the same one in a world).
		}

		RandomizePotDrops: {
			Label: Randomize pot loot
			Tooltip: Items from pots are replaced by items of the same category. Coins and hearts are unchanged.
		}

		RandomizeTreeShaking: {
			Label: Randomize shaken trees
			Tooltip: Fruits and items falling from shaken trees are replaced (same kind, or a surprise).
		}

		KeepAcorns: {
			Label: Keep acorns
			Tooltip: Shaken trees still give acorns, so trees can be replanted.
		}

		RandomizeHerbs: {
			Label: Randomize herbs and plants
			Tooltip: Herbs, mushrooms, jungle spores and other plants give other materials of their tier. Seeds are kept.
		}

		HerbKeepChance: {
			Label: Herbs kept (%)
			Tooltip: Chance that a herb or plant still gives its usual item.
		}

		HerbVariety: {
			Label: Items per herb
			Tooltip: Number of different items each herb or plant can turn into in a world.
		}

		RandomizeExtractinator: {
			Label: Randomize the Extractinator
			Tooltip: Items from the Extractinator are replaced (ores by other ores of the same tier). Coins are kept.
		}

		RandomizeAnglerRewards: {
			Label: Randomize Angler rewards
			Tooltip: Rewards of the Angler's fishing quests are replaced. Coins and bait are kept.
		}

		SurpriseChance: {
			Label: Surprise chance (%)
			Tooltip: Chance that a replaced item (enemy drop, chest, pot, bag, fish...) becomes an item of any category, rolled with the loot weights, instead of keeping its kind. 0 = always the same kind, 100 = anything.
		}

		TierWindow: {
			Label: Tier window
			Tooltip: Random items are also picked among this many tiers below the target. More variety, especially early in the game.
		}
	}

	CategoryWeights: {
		Tooltip: ""

		Material: {
			Label: Materials
			Tooltip: ""
		}

		OreBar: {
			Label: Ores and bars
