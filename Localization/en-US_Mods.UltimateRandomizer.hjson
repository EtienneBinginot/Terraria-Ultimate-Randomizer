	GeneralConfig: {
		DisplayName: 1. General

		Headers: {
			Mode: Mode
			Seed: Seed
			Exclusions: Exclusions
		}

		RandomizerMode: {
			Label: Randomizer mode
			Tooltip:
				'''
				Chaos: anything can come from anywhere (like the original tRandomizer).
				Coherent: random, but categories and tiers are respected and items unlock with progression.
				Guaranteed shuffle: every item is swapped with another of the same category and tier, so everything stays obtainable.
				'''
		}

		SeedSource: {
			Label: Seed of new worlds
			Tooltip:
				'''
				Random: each world gets its own random seed.
				From the world seed: two worlds created with the same seed get the same randomization.
				Fixed: every new world uses the fixed seed below.
				'''
		}

		FixedSeed: {
			Label: Fixed seed
			Tooltip: Used when the seed source is Fixed.
		}

		AllowSeedChange: {
			Label: Allow /rseed to change the seed
			Tooltip: Lets the host (or the single player) change the seed of the current world with /rseed set or /rseed random.
		}

		ExcludedItems: {
			Label: Excluded items
			Tooltip: These items are never randomized and never given as a random item.
		}

		ExcludedMods: {
			Label: Excluded mods
			Tooltip: Internal names of mods whose items are left out of the randomizer (for example CalamityMod).
		}
	}

	ProgressionConfig: {
		DisplayName: 2. Progression and protection

		Headers: {
			TierGating: Unlocking items with progression
			Protection: Protected progression items
			Tiers: Tiers
		}

		TierGating: {
			Label: Lock items behind progression
			Tooltip:
				'''
				Items of a tier not unlocked yet (bosses defeated) are replaced by an item of the highest allowed tier,
				until you progress. Prevents getting the Zenith from the first slime.
				'''
		}

		TierAllowance: {
			Label: Tiers allowed above your progression
			Tooltip: 0 = only tiers already unlocked. 1 = one tier ahead (default), and so on.
		}

		JackpotTierChance: {
			Label: Jackpot chance (%)
			Tooltip: Chance for a drop slot to aim 2 or 3 tiers higher than normal. It still respects the progression lock.
		}

		RuntimeJackpotChance: {
			Label: Lucky drop chance (%)
			Tooltip: Chance, on each kill, to ignore the progression lock and get the real item right away.
		}

		MechTierRequiresAllThree: {
			Label: Mechanical tier needs the three mechanical bosses
			Tooltip: Off: one mechanical boss is enough to unlock the tier.
		}

		ScaleWeakEnemiesWithProgression: {
			Label: Weak enemies follow your progression
			Tooltip: On: early enemies drop items close to your current tier instead of staying at their own level.
		}

		ProtectedItems: {
			Label: Protected items
			Tooltip: Never replaced (drops, recipes...) and never given as a random item. Keeps progression possible.
		}

		AutoProtectBossSummons: {
			Label: Protect all boss summons
			Tooltip: Also protects boss summoning items from other mods.
		}

		ProtectCraftingStations: {
			Label: Protect crafting stations
			Tooltip: Work benches, anvils, furnaces... any item placing a tile that some recipe requires.
		}

		ProtectPickaxeProgression: {
			Label: Protect pickaxe recipes
			Tooltip: Pickaxe recipes are never randomized, so you can always mine the next ore.
		}

		TierOverrides: {
			Label: Tier overrides
			Tooltip: Forces the tier of specific items (useful for items from other mods).
		}
	}

	TierOverride: {
		Tooltip: ""

		Item: {
			Label: Item
			Tooltip: ""
		}

		Tier: {
			Label: Tier
			Tooltip: ""
		}
	}

	LootConfig: {
		DisplayName: 3. Loot

		Headers: {
			Mobs: Enemies and bosses
			Bags: Bags and crates
			World: World: chests, fishing, mining
		}

		RandomizeMobDrops: {
			Label: Randomize enemy and boss drops
			Tooltip: Progression drops (protected items) and treasure bags keep their original chance.
		}

		DropTableStyle: {
			Label: Drop table style
			Tooltip:
				'''
				Vanilla-like: each enemy has a random number of drops (usually few, sometimes many) with rates like the base game
				(1/1 for materials, 1/50 for equipment...). Items above the enemy's level are rarer.
				Mirror of the original: same number of drops and same rates as the original enemy, each item replaced by one of the same category.
				Simple: every slot has the fixed chance below.
				'''
		}

		EnemiesWithoutDropsCanDrop: {
			Label: Enemies without drops can drop items
			Tooltip: Enemies that drop nothing in the base game also get random drops.
		}

		CrittersCanDrop: {
			Label: Critters can drop items
			Tooltip: Bunnies, birds, butterflies... also get random drops.
		}

		DropRateMultiplier: {
			Label: Drop rate multiplier
			Tooltip: Multiplies every drop chance (vanilla-like and mirror styles). 2 = twice as many drops.
		}


		DropSlotsMin: {
			Label: Random drop slots (minimum)
			Tooltip: Number of possible random drops of a normal enemy. Each enemy type gets its own fixed number in a world, usually close to the minimum.
		}

		DropSlotsMax: {
			Label: Random drop slots (maximum)
			Tooltip: ""
		}

		DropChance: {
			Label: Drop chance of each slot (%)
			Tooltip: Only used by the Simple style. Items above the enemy's level are rarer.
		}

		BossDropSlotsMin: {
			Label: Boss drop slots (minimum)
			Tooltip: In expert and master mode, bosses with a treasure bag put their loot in the bag instead.
		}

		BossDropSlotsMax: {
			Label: Boss drop slots (maximum)
			Tooltip: ""
		}

		DropCategoryWeights: {
			Label: Category weights of random drops
			Tooltip: Relative chance of each kind of item. 0 = never. Lower dyes and vanity to get more useful items.
		}

		RandomizeBossBags: {
			Label: Randomize treasure bags
			Tooltip: Each item in the bag is replaced by an item of the same category and tier.
		}

		RandomizeCrates: {
			Label: Randomize fishing crates
			Tooltip: ""
		}

		RandomizeOtherBags: {
			Label: Randomize other bags
			Tooltip: Goodie bags, presents, herb bags, geodes, cans of worms...
		}

		RandomizeChests: {
			Label: Randomize chests of new worlds
			Tooltip: "Each item of a natural chest is replaced by an item of the same category, at world creation. For older worlds, use /rchests."
		}

		ChestTierBonus: {
			Label: Chest tier bonus
			Tooltip: "Makes chest content this many tiers better."
		}

		RandomizeFishing: {
			Label: Randomize fishing
			Tooltip: "Each fish gives another item of the same category and tier. Quest fish are never changed."
		}

		CratesStayCrates: {
			Label: Crates stay crates
			Tooltip: "Fished crates are not replaced (their content is randomized when opened)."
		}

		RandomizeOreDrops: {
			Label: Randomize mined ores
			Tooltip: "Each ore gives another ore or bar of the same tier (always the same one in a world)."
		}

		RandomizePotDrops: {
			Label: Randomize pot loot
			Tooltip: "Items from pots are replaced by items of the same category. Coins and hearts are unchanged."
		}
	}

