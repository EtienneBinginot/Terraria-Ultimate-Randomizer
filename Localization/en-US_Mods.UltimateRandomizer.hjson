			Label: All stations
			Tooltip: ""
		}

		ProgressionOnly: {
			Label: Progression stations only
			Tooltip: ""
		}

		None: {
			Label: None
			Tooltip: ""
		}

		Tooltip: ""
	}

	IngredientMode: {
		Randomized: {
			Label: Randomized
			Tooltip: ""
		}

