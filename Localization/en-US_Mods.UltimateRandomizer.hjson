	EconomyConfig: {
		DisplayName: 4. Economy

		Headers: {
			Shops: Shops
			Stacks: Stack sizes
		}

		RandomizeShops: {
			Label: Randomize shops
			Tooltip: Each shop item is replaced by an item of the same category. It keeps the original item's unlock conditions. The items that nothing else gives in this world (not found nor craftable) are still sold, possibly by another merchant.
		}

		PriceMultiplierMin: {
			Label: Price multiplier (minimum)
			Tooltip: Price = item value x a random multiplier. Never below 1, so buying and reselling never makes money.
		}

		PriceMultiplierMax: {
			Label: Price multiplier (maximum)
			Tooltip: ""
		}

		MinimumPrice: {
			Label: Minimum price (copper coins)
			Tooltip: For the items that don't stack. 100 copper = 1 silver.
		}

		MinimumStackablePrice: {
			Label: Minimum price of stackable items (copper coins)
			Tooltip: Ammo, blocks, potions and other stackable items are bought one at a time: they keep their own small price down to this one.
		}

		PriceCeiling: {
			Label: Price ceiling (by tier)
			Tooltip: No price above a base price of the item's tier x this value (weapons, armor, accessories and tools: 4 times more), so a shop item stays affordable when it is sold. Items worth more than that, other than gear (vanity, furniture, pets...), are seldom sold. Never below half the item's value. 0: no ceiling.
		}

		NoDuplicatesInShop: {
			Label: No duplicates in a shop
			Tooltip: ""
		}

		MaxShopsPerItem: {
			Label: Most merchants selling the same item
			Tooltip: Across the whole world, a randomized item is sold by this many merchants at most, so that the shops stay varied. Each merchant sells it in one of its tabs only. 0: no limit.
		}

		ShopsFollowProgression: {
			Label: Shops follow progression
			Tooltip: Shops sell better items as you defeat bosses.
		}

		StackCaps: {
			Label: Maximum stack per category
			Tooltip: Largest amount given at once. The item's own maximum stack still applies.
		}

		StackMultiplier: {
			Label: Stack multiplier
			Tooltip: Multiplies all the maximums above.
		}

		ValueBasedStacks: {
			Label: Keep the value of replaced items
			Tooltip: When an item replaces another, the amount is adjusted so the total value stays close to the original.
		}
	}

	StackCaps: {
		Tooltip: ""

