	CraftingConfig: {
		DisplayName: 5. Crafting and shimmer

		Headers: {
			Recipes: Recipes
			Shimmer: Shimmer
			Ingredients: Recipe ingredients
			Stations: Crafting stations of recipes
		}

		RandomizeRecipes: {
			Label: Randomize recipes
			Tooltip: Rebuilds the recipes from the seed: each one keeps its item (a few swap theirs, see below) but gets new ingredients and stations, doable at its level. Recipes go back to normal when you leave the world.
		}

		RandomizeModdedRecipes: {
			Label: Randomize other mods' recipes
			Tooltip: Recipes added by other mods (Magic Storage...) are randomized like the vanilla ones: new ingredients and stations, and the odd swapped result. Each one keeps a key ingredient of its item's level, so a storage upgrade still waits for its bars. Off: they stay as their mod made them. Adding or removing mods, or changing this setting, changes this world's random results; turning it back off does not bring the previous ones back.
		}

		LimitRecipeValue: {
			Label: Limit the value of results
			Tooltip: On: when the item of a randomized recipe is worth more than 'Value guard' times its new ingredients, they are raised to the worth of the vanilla ingredients. Off: the amounts follow the vanilla amounts, the value only caps them.
		}

		RecipeValueGuard: {
			Label: Value guard
			Tooltip: When 'Limit the value of results' is on: a result can be worth at most this many times its ingredients.
		}

		CraftedValueFromIngredients: {
			Label: Crafted items sell for their ingredients
			Tooltip: An item made through a randomized recipe sells for what its ingredients were worth (never more than its normal price), so crafting can't be used to make money.
		}

		DisableDecraftOfRandomizedResults: {
			Label: No shimmer decrafting of random results
			Tooltip: Prevents duplicating items by crafting a random result then decrafting it in shimmer.
		}

		RecipeResultSwapChance: {
			Label: Recipe result swap chance (%)
			Tooltip: Share of the randomized recipes that swap their result with another recipe of the same tier, by pairs (every item stays craftable, often by an unexpected recipe). A swapped recipe gets ingredients worthy of the item it now gives (its level, its value), mostly of the kinds its own recipe used, with a touch of the item's.
		}

		IngredientMode: {
			Label: Ingredients
			Tooltip: Randomized: every recipe is rebuilt from materials you can find or craft by its level, keeping only the rough shape of the vanilla recipe (number and kinds of ingredients, value), with at least one ingredient of its own level. Vanilla: ingredients are kept and each one is placed on enemies of the recipe's level.
		}

		IngredientWeights: {
			Label: Ingredient weights
			Tooltip: Relative chance of each kind of item among the ingredients of a rebuilt recipe. 0 = never, unless the vanilla recipe used that kind (a recipe made of weapons often gets weapons again).
		}

		IngredientSurpriseChance: {
			Label: Ingredient surprise chance (%)
			Tooltip: Chance that an ingredient of a rebuilt recipe is of any kind (drawn with the loot weights: weapons, accessories, potions...) instead of the ingredient weights. Its level stays the slot's; its value only has to fit within the recipe's value cap.
		}

		IngredientCountSpread: {
			Label: Ingredient count spread
			Tooltip: Every recipe is rebuilt with about as many ingredients as the vanilla one: this many more or fewer at most (the same count, one more or one less are the most frequent). 0 = always the vanilla count.
		}

		IngredientMax: {
			Label: Maximum ingredients per recipe
			Tooltip: A rebuilt recipe never has more ingredients than this (ingredients that can't be replaced, like boss items, are kept anyway).
		}

		RecipesForUncraftable: {
			Label: Recipes for uncraftable items
			Tooltip: Items that no recipe makes (walls, blocks only obtained by breaking them, furniture found in the world, vanity, dyes, food, materials) get a random recipe at a random station. It can only be made from the tier at which the item would be found, never earlier. Gear, ammo, potions, ores, stations, boss summons and bags never get one.
		}

		IngredientStackCap: {
			Label: Maximum amount of an ingredient
			Tooltip: Largest amount of a new common ingredient (blocks, wood, gel, common drops). The amounts follow the vanilla amounts (half to two and a half times as many in all), within this limit and the two below; a recipe is never worth more than twice its vanilla ingredients.
		}

		CraftedIngredientStackCap: {
			Label: Maximum amount of a crafted-only ingredient
			Tooltip: Largest amount of a new ingredient that can only be crafted (never found). Each one is a craft of its own, so large amounts add up fast. A little more is allowed when its own recipe is cheap.
		}

		SlowIngredientStackCap: {
			Label: Maximum amount of a slow ingredient
			Tooltip: Largest amount of a new ingredient that is gathered slowly: gems, Fallen Stars, herbs, fish, critters, shards, souls, uncommon drops.
		}

		IngredientReusePenalty: {
			Label: Ingredient reuse penalty
			Tooltip: Makes the same materials appear in fewer recipes: a material already used by n recipes is picked with its weight divided by (1 + this value x n), common materials tolerating more uses. 0 = no penalty.
		}

		RandomizeStations: {
			Label: Randomize crafting stations
			Tooltip: Recipes may require another station of the same or a lower level. Recipes made by hand stay by hand, progression recipes keep theirs.
		}

		StationKeepChance: {
			Label: Station kept (%)
			Tooltip: Chance that a recipe keeps its own station.
		}

		RandomizeShimmer: {
			Label: Randomize shimmer transmutations
			Tooltip: Each shimmer transformation gives another item of the same category and tier. Decrafting is not affected.
		}
	}

	EnemySwapMode: {
		Tooltip: ""

		PerType: {
			Label: Per type
			Tooltip: ""
		}

		PerSpawn: {
			Label: Per spawn
			Tooltip: ""
		}

		ByBiome: {
			Label: By biome
			Tooltip: ""
		}
	}

	EnemiesConfig: {
		DisplayName: 6. Enemies and bosses

		Headers: {
			Bosses: Bosses
			Enemies: Normal enemies
			EnemySwap: Random enemies
			GiantsAndMinis: Giants and minis
			LootBonus: Loot of strong enemies
			DamageLimit: Damage limit
		}

		RandomizeBossHealth: {
			Label: Randomize boss health
			Tooltip: The normal health of each boss is multiplied by a random value between the minimum and maximum, fixed for the world. Expert and master bonuses apply on top.
		}

		BossHealthMin: {
			Label: Boss health: minimum multiplier
			Tooltip: 0.5 = half health.
		}

		BossHealthMax: {
			Label: Boss health: maximum multiplier
			Tooltip: 3 = triple health.
		}

		RandomizeBossDamage: {
			Label: Randomize boss damage
			Tooltip: Contact damage and projectiles of each boss are multiplied by a random value fixed for the world.
		}

		BossDamageMin: {
			Label: Boss damage: minimum multiplier
			Tooltip: ""
		}

		BossDamageMax: {
			Label: Boss damage: maximum multiplier
			Tooltip: Keep it low: defense is subtracted from damage, so a small multiplier already hurts a lot more.
		}

		BossStatExtremeness: {
			Label: Boss extreme values rarity
			Tooltip: 1 = every value in the range is as likely. Higher: values far from normal are rarer.
		}

		BossIndividualVariation: {
			Label: Boss variation between fights (%)
			Tooltip: Each boss fight varies a little around the boss's values of this world.
		}

		BossGiantChance: {
			Label: Giant boss chance (%)
			Tooltip: Chance that a boss is a giant (bigger, much tougher). Some bosses may behave oddly when giant.
		}

		RandomizeEnemyStats: {
			Label: Randomize normal enemies
			Tooltip: Health, damage, defense and size of each enemy type are multiplied by random values fixed for the world.
		}

		EnemyHealthMin: {
			Label: Health: minimum multiplier
			Tooltip: ""
		}

		EnemyHealthMax: {
			Label: Health: maximum multiplier
			Tooltip: ""
		}

		EnemyDamageMin: {
			Label: Damage: minimum multiplier
			Tooltip: ""
		}

		EnemyDamageMax: {
			Label: Damage: maximum multiplier
			Tooltip: Keep it low: defense is subtracted from damage, so a small multiplier already hurts a lot more. Health is the place for big multipliers.
		}

		EnemyDefenseMin: {
			Label: Defense: minimum multiplier
			Tooltip: ""
		}

		EnemyDefenseMax: {
			Label: Defense: maximum multiplier
			Tooltip: ""
		}

		EnemyScaleMin: {
			Label: Size: minimum multiplier
			Tooltip: Changes the hitbox too. Large values can make enemies get stuck.
		}

		EnemyScaleMax: {
			Label: Size: maximum multiplier
			Tooltip: ""
		}

		StatExtremeness: {
			Label: Extreme values rarity
			Tooltip: 1 = every value in the ranges is as likely. Higher: values far from normal are rarer, but still possible.
		}

		ScaleFollowsLife: {
			Label: Size follows health
			Tooltip: 0 = size and health are unrelated. 1 = tougher enemy types are bigger.
		}

		IndividualVariation: {
			Label: Variation between individuals (%)
			Tooltip: Each enemy varies a little around the values of its type in this world (health, damage, defense, size).
		}

		GiantChance: {
			Label: Giant chance (%)
			Tooltip: Chance that an enemy is a giant: much bigger, tougher and more dangerous, with better loot.
		}

		GiantSizeMin: {
			Label: Giant size (minimum)
			Tooltip: Size multiplier of giants. Big sizes are rarer.
		}

		GiantSizeMax: {
			Label: Giant size (maximum)
			Tooltip: ""
		}

		MiniChance: {
			Label: Mini chance (%)
			Tooltip: Chance that an enemy is a mini: tiny, weaker, hard to hit.
		}

		MiniSizeMin: {
			Label: Mini size (minimum)
			Tooltip: Size multiplier of minis. The smallest sizes are rarer.
		}

		MiniSizeMax: {
			Label: Mini size (maximum)
			Tooltip: ""
		}

		MaxGiantPixels: {
			Label: Largest giant (pixels)
			Tooltip: A giant is never wider or taller than this (a tile is 16 pixels), so it can still move around.
		}

		LootBonusStrength: {
			Label: Loot bonus strength
			Tooltip: Stronger enemies (health x damage x damage above normal: damage counts twice, defense is subtracted from it) have better extra drop chances. 0 = no bonus.
		}

		LootBonusCap: {
			Label: Loot bonus cap
			Tooltip: Largest multiplier of the extra drop chances.
		}

		GiantBonusDrop: {
			Label: Giants drop one more item
			Tooltip: A giant always drops one more useful item (equipment or a crafting station), a tier above its level within the progression limit, five times as likely to be a jackpot.
		}

		MiniBonusDrop: {
			Label: Minis drop one more item
			Tooltip: A mini (small, quick and dangerous) always drops one more random item of its level, twice as likely to be a jackpot.
		}

		RandomizeEnemySpawns: {
			Label: Randomize enemy spawns
			Tooltip: Naturally spawning enemies become another enemy of the same tier that moves the same way (ground, flying, water). Bosses and worms are never changed.
		}

		EnemySwapMode: {
			Label: Replacement mode
			Tooltip: By biome: the natural enemies are shared out again between the biomes; each one keeps its number of spawn places, rare enemies stay rare and hardmode enemies come with hardmode. Per type: each enemy is always replaced by the same other enemy in a world. Per spawn: every spawn picks a new replacement.
		}

		EnemySwapChance: {
			Label: Replacement chance (%)
			Tooltip: Per type and per spawn modes: share of enemies (per type) or of spawns (per spawn) that are replaced. The by-biome mode uses the vanilla enemy chance instead.
		}

		BiomeVanillaChance: {
			Label: Vanilla enemy chance (%)
			Tooltip: By biome: chance that a spawn stays the enemy vanilla would have spawned. 0 = every spawn follows the biome's new list.
		}

		BiomeExtraEnemies: {
			Label: Unusual guests (%)
			Tooltip: By biome: share of the spawn places shared with enemies that normally only come with an event (Blood Moon, eclipse, goblins, pirates...): there, each spawn is that guest half of the time, so the usual enemy of the place comes half as often. No enemy loses a place.
		}

		SwapCritters: {
			Label: Also swap critters
			Tooltip: Critters are only swapped with other critters.
		}

		SwapEventEnemies: {
			Label: Also swap invasion enemies
			Tooltip: Goblin army, pirates, Frost Legion, Martians, Old One's Army.
		}

		SwapModdedEnemies: {
			Label: Include enemies from other mods
			Tooltip: Their enemies are redistributed too, including in their own biomes.
		}

		MaxDamageMultiplier: {
			Label: Total damage: maximum multiplier
			Tooltip: The randomizer never multiplies the damage of an enemy, boss or boss part by more than this in total (type, variation, giant and adaptive power together; expert and master scaling still apply on top). Damage is far stronger than health in Terraria: defense is subtracted from it, so x10 damage turns a 1 damage hit into a one-shot.
		}
	}

	ExtrasConfig: {
		DisplayName: 7. Extras

		Headers: {
			StartingKit: Starting kit
			TownNpcs: Town NPCs
			Hints: Hints
		}

		StartingKit: {
			Label: Random starting kit
			Tooltip: Gives each character a random kit the first time it enters a world.
		}

		KitWeapons: {
			Label: Weapons
			Tooltip: ""
		}

		KitAccessories: {
			Label: Accessories
			Tooltip: ""
		}

		KitPotions: {
			Label: Potions
			Tooltip: ""
		}

		KitTools: {
			Label: Tools
			Tooltip: ""
		}

		MagicStorageKit: {
			Label: Magic Storage kit
			Tooltip: With Magic Storage loaded: gives each character, once per world, a Storage Heart, 4 Storage Units, a Crafting Access and the basic Portable Access and Portable Crafting Access.
		}

		RandomizeTownNpcOrder: {
			Label: Random arrival order of town NPCs
			Tooltip: Each arrival condition brings another NPC: the Wizard may come with 50 silver, the Merchant after Skeletron... Fixed for the world. Rescued NPCs (Goblin, Mechanic...) are not affected.
		}

		HintBasePrice: {
			Label: Base price of a hint (gold)
			Tooltip: Price in gold coins of the first hint level about a tier 0 item, bought from the Guide (Hint button). Each tier adds 1.5 times this, each level costs 3 times the previous one: 2 gold gives 2, 6, 18 and 54 gold for a work bench. 0: free.
		}
	}

	ClientConfig: {
		DisplayName: 8. Client

		Headers: {
			Debug: Debug tools
			Messages: Messages
			Display: Display
		}

		DebugTools: {
			Label: Debug tools (K key)
			Tooltip: Testing tools for the mod's developers: the K panel (state of the randomizer, inspector, cheats, automated tests) and the /rdebug and /rtest commands. They reveal the whole randomization: off by default.
		}

		AdaptiveMessages: {
			Label: Adaptive power messages
			Tooltip: Tells you in the chat when your equipment makes enemies stronger, or when the world caught up with it.
		}

		ShowWorldDrops: {
			Label: Show this world's drops
			Tooltip: With the Permutation enemy drop style: the bestiary and Recipe Browser show what enemies, bosses and treasure bags drop in this world (shuffled drops, extra and guaranteed drops) instead of the vanilla drops. Off: they show the vanilla drops.
		}
	}

	StationProtection: {
