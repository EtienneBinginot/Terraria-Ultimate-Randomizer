	EnemiesConfig: {
		DisplayName: 6. Ennemis et boss

		Headers: {
			Bosses: Boss
			Enemies: Ennemis normaux
			EnemySwap: Ennemis aléatoires
		}

		RandomizeBossHealth: {
			Label: Randomiser la vie des boss
			Tooltip: La vie normale de chaque boss est multipliée par une valeur aléatoire entre le minimum et le maximum, fixe pour le monde. Les bonus expert et maître s'ajoutent par-dessus.
		}

		BossHealthMin: {
			Label: Vie des boss : multiplicateur minimum
			Tooltip: 0.5 = moitié de la vie.
		}

		BossHealthMax: {
			Label: Vie des boss : multiplicateur maximum
			Tooltip: 3 = triple de la vie.
		}

		RandomizeBossDamage: {
			Label: Randomiser les dégâts des boss
			Tooltip: Les dégâts de contact et les projectiles de chaque boss sont multipliés par une valeur aléatoire fixe pour le monde.
		}

		BossDamageMin: {
			Label: Dégâts des boss : multiplicateur minimum
			Tooltip: ""
		}

		BossDamageMax: {
			Label: Dégâts des boss : multiplicateur maximum
			Tooltip: ""
		}

		RandomizeEnemyStats: {
			Label: Randomiser les ennemis normaux
			Tooltip: La vie, les dégâts, la défense et la taille de chaque type d'ennemi sont multipliés par des valeurs aléatoires fixes pour le monde.
		}

		EnemyHealthMin: {
			Label: Vie : multiplicateur minimum
			Tooltip: ""
		}

		EnemyHealthMax: {
			Label: Vie : multiplicateur maximum
			Tooltip: ""
		}

		EnemyDamageMin: {
			Label: Dégâts : multiplicateur minimum
			Tooltip: ""
		}

		EnemyDamageMax: {
			Label: Dégâts : multiplicateur maximum
			Tooltip: ""
		}

		EnemyDefenseMin: {
			Label: Défense : multiplicateur minimum
			Tooltip: ""
		}

		EnemyDefenseMax: {
			Label: Défense : multiplicateur maximum
			Tooltip: ""
		}

		EnemyScaleMin: {
			Label: Taille : multiplicateur minimum
			Tooltip: Change aussi la hitbox. De grandes valeurs peuvent bloquer les ennemis.
		}

		EnemyScaleMax: {
			Label: Taille : multiplicateur maximum
			Tooltip: ""
		}

		RandomizeEnemySpawns: {
			Label: Randomiser les apparitions d'ennemis
			Tooltip: Les ennemis qui apparaissent naturellement deviennent un autre ennemi du même tier qui se déplace pareil (sol, vol, eau). Les boss et les vers ne changent jamais.
		}

		EnemySwapMode: {
			Label: Mode de remplacement
			Tooltip: Par type : chaque ennemi est toujours remplacé par le même autre ennemi dans un monde. À chaque apparition : chaque apparition tire un nouveau remplaçant.
		}

		EnemySwapChance: {
			Label: Chance de remplacement (%)
			Tooltip: Part des ennemis (par type) ou des apparitions (à chaque apparition) qui sont remplacés.
		}

		SwapCritters: {
			Label: Remplacer aussi les critters
			Tooltip: Les critters ne sont remplacés que par d'autres critters.
		}

		SwapEventEnemies: {
			Label: Remplacer aussi les ennemis d'invasion
			Tooltip: Armée gobeline, pirates, Légion du givre, Martiens, Armée de l'Ancien.
		}

		SwapModdedEnemies: {
			Label: Inclure les ennemis des autres mods
			Tooltip: ""
		}
	}

