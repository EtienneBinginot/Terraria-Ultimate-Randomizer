Keybinds: {
	Debug.DisplayName: Ouvrir le panneau de débogage du randomizer
	Journal.DisplayName: Ouvrir le journal du randomizer
}

Debug: {
	Title: Ultimate Randomizer - débogage
	NeedWorld: Charge d'abord un monde.
	SinglePlayerOnly: Cette action ne marche qu'en solo.
	TabOverview: Vue d'ensemble
	TabInspector: Inspecteur
	TabTools: Outils
	TabTests: Tests
	On: oui
	Off: non
	Seed: Graine
	Mode: Mode
	Network: Partie
	SinglePlayer: solo
	Multiplayer: multijoueur
	Tier: Tier débloqué
	Limit: Tier max autorisé
	Gating: Blocage
	Pool: Objets randomisables / protégés / exclus
	Snapshots: Tables de loot ennemis / sacs
	Swaps: Remplacements
	SwapStats: "{0} repérés : {1} ennemis et {2} critters remplacés ; {3} non remplaçables, {4} gardés par le hasard, {5} sans remplaçant"
	Recipes: Recettes
	Shimmer: Shimmer
	Chests: Coffres
	SetTier: Régler la progression (boss vaincus) au tier :
	NewSeed: Nouvelle graine
	PoolTable: Objets par catégorie, tiers 0 à 9 :
	TierSet: Progression réglée sur {0}.
	SeedSet: Nouvelle graine : {0}.
	HoverItem: Objet sous la souris (ou en main)
	NoItem: Survole un objet ou tiens-en un.
	ItemInfo: Catégorie {0}, tier {1} ({2}), protégé {3}, exclu {4}, stack {5}-{6}, valeur {7}
	ShufflePartner: Partenaire du mélange garanti : {0}
	NearestNpc: PNJ le plus proche de la souris
	NoNpc: Aucun PNJ près de la souris.
	NpcTier: tier {0} (tirages : {1})
	Multipliers: Multiplicateurs : vie x{0}, dégâts x{1}, défense x{2}, taille x{3}
	Swappable: Peut être remplacé par les ennemis aléatoires.
	NotSwappable: Jamais remplacé par les ennemis aléatoires.
	Drops: Loot dans ce monde :
	NoDrops: Ne donne rien dans ce monde.
	ExtraTag: (en plus)
	ConditionTag: (conditions)
	Player: Joueur
	GodMode: Invincible
	SpawnRate: Apparitions
	SpawnRateNormal: normales
	SpawnRateNone: aucune
	SpawnRateHigh: beaucoup
	ToggleGodMode: Invincible oui/non
	CycleSpawnRate: Taux d'apparition
	GiveKit: Kit de test
	World: Monde
	Day: jour
	Night: nuit
	SpawnEnemies: Faire apparaître 5 ennemis
	KillHostiles: Tuer les ennemis à l'écran
	ToggleDay: Jour/nuit
	GiveBags: Tous les sacs de boss
	OpenJournal: Journal
	ToolsHelp: Astuce : onglet Inspecteur + souris sur un ennemi = son loot ; tue-le pour comparer. Les ennemis invoqués apparaissent comme des naturels (les ennemis aléatoires s'appliquent).
	RunTests: Lancer tous les tests
	TestsHelp: Lance tous les tests automatiques dans le monde actuel. Les résultats vont aussi dans client.log.
	TestSummary: "{0} réussis, {1} échoués, {2} ignorés"
}

Tests: {
	NoWorld: Monde chargé
	PoolBuilt: Liste d'objets construite, chaque catégorie principale a des objets
	Classification: Les objets connus sont bien classés
	Determinism: Les tirages sont déterministes et dépendent de la graine
	GatingRespected: Aucun objet au-dessus du tier autorisé (blocage par progression)
	NoProtectedRolled: Les objets protégés et exclus ne sont jamais donnés au hasard
	SameCategory: Les remplaçants gardent la catégorie
	ShuffleBijection: Mélange garanti : chaque objet obtenable est donné exactement une fois
	StackRules: Les tailles de stack sont valides
	PriceFloor: Les prix des boutiques ne sont jamais sous la valeur de l'objet
	DropRates: Les taux de drop sont valides
	SnapshotsCaptured: Les tables de loot d'origine ont été lues
	MobPlansValid: Toutes les tables de loot des ennemis sont valides
	ProtectedDropsKept: Les drops de progression sont conservés
	NoMinionFarms: Les minions de boss et les PNJ n'ont pas de drops aléatoires
	EventItemsKept: Objets de l'Armée de l'Ancien et segments de boss préservés
	SwapSurvivesVariantSetDefaults: Les variantes d'ennemis (Pinky, zombies) sont bien remplacées
	CritterSwapLive: Les critters sont vraiment remplacés, dans le même habitat
	CritterPoolSafe: Aucun critter doré, Chrysope prismatique, Ver truffe ou critter de lave ne peut en remplacer un autre
	CritterHabitat: Les critters aquatiques, volants et terrestres restent dans leur habitat
	SwapStatsCount: Les apparitions naturelles sont comptées, celles des statues ignorées
	SurpriseZero: Avec 0 % de surprise, les objets remplacés gardent leur catégorie
	SurpriseHundred: Avec 100 % de surprise, les catégories suivent les poids du loot
	SurpriseGatedAndProtected: Les surprises respectent la progression et les objets protégés
	RecipeSurpriseRate: La part de recettes qui changent de catégorie suit le réglage
	WeightTablesSeparated: Les poids du loot favorisent l'équipement, ceux des ingrédients jamais
	TierWindowVariety: Les tirages de début de partie donnent beaucoup d'objets différents
	OreMappingBijective: Chaque minerai existe encore, comme drop d'un seul autre minerai
	TreeShakeReplacement: Les arbres secoués donnent des objets aléatoires et gardent les glands
	HerbReplacementTable: Chaque herbe a un ensemble fixe de remplaçants valides
	ExtractinatorRules: L'Extractinator garde les pièces et échange les minerais contre des minerais
	AnglerRewardsValid: Les récompenses du Pêcheur sont des objets valides, pièces conservées
	TreeCritterSwap: Les critters qui tombent des arbres sont aussi remplacés
	BagPlansValid: Tous les contenus de sacs sont valides
	BagsKeepCoins: Les sacs de boss gardent leurs pièces
	RecipesSafe: Recettes : pas d'ingrédient identique au résultat, garde-fou respecté
	MiningProtected: Les recettes de pioches et de lingots ne changent pas
	DecraftSafe: Le décraft au Shimmer ne peut pas dupliquer d'objets
	ShimmerCoherent: Les transformations du Shimmer gardent catégorie et valeur
	ShopSimulation: Boutique simulée : pas de doublons, prix justes, cases spéciales intactes
	EnemySwapPool: Ennemis aléatoires : ni morceaux de boss, ni minions, ni ennemis d'événement
	EnemySwapDaylight: Ennemis aléatoires : rien qui fuit le jour, de jour
	TownOrderPermutation: L'ordre des PNJ est une permutation valide
	EnemyStatRanges: Les multiplicateurs des boss restent dans les limites
	ConfigTexts: Chaque réglage a un texte
	OtherTexts: Chaque message a un texte
	ConfigRanges: Les réglages sont cohérents
}

Journal: {
	Title: Journal du randomizer
	Monsters: Monstres
	Bags: Sacs
	Empty: Rien de découvert pour l'instant : tue des monstres et ouvre des sacs !
	Tier: tier {0}
	Description: Ouvre le journal du randomizer (aussi avec la touche J)
}

Chat: {
	ConfigHostOnly: Seul l'hôte peut modifier les réglages d'Ultimate Randomizer.
	OldRandomizerEnabled: "[Ultimate Randomizer] tRandomizer est aussi activé : le loot est randomisé deux fois. N'active qu'un seul des deux randomizers dans Manage Mods."
	StartingKit: Ultimate Randomizer : tu as reçu un kit de départ aléatoire pour ce monde !
}

Commands: {
	Seed: {
		Description: Affiche ou change la graine du randomizer de ce monde
		Show: Graine du randomizer de ce monde : {0}
		Changed: Graine changée en {0} : tout est randomisé à nouveau.
		NotAllowed: Seul l'hôte peut changer la graine, et seulement si la config l'autorise.
	}

	Debug: {
		Description: Informations de débogage du randomizer
		NotFound: Introuvable : {0}
		Item: "{0} : {1}, tier {2} ({3}), protégé : {4}, exclu : {5}, stack {6}-{7}"
		Npc: "{0} : tier {1} (utilisé pour les tirages : {2})"
		Tier: Tier débloqué : {0} ({1})
		PoolLogged: La répartition des objets a été écrite dans client.log.
		NoDrops: Cet ennemi ne donne rien dans ce monde.
	}

	Chests: {
		Description: Randomise les coffres naturels d'un monde créé sans le mod
		AlreadyDone: Les coffres sont déjà randomisés dans ce monde.
		Warning: Ceci randomise une fois les coffres naturels de ce monde. Les coffres renommés, et ceux près du point d'apparition ou des maisons des PNJ (sûrement les tiens), sont ignorés. Tape /rchests confirm pour continuer.
		Done: "{0} coffres randomisés."
	}
}

