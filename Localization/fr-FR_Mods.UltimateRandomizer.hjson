Keybinds: {
	Debug.DisplayName: Ouvrir le panneau de débogage du randomizer
	Journal.DisplayName: Ouvrir le codex du randomizer
}

Debug: {
	Title: Ultimate Randomizer - débogage
	NeedWorld: Charge d'abord un monde.
	SinglePlayerOnly: Cette action ne marche qu'en solo.
	TabOverview: Vue d'ensemble
	TabInspector: Inspecteur
	TabTools: Outils
	TabTests: Tests
	On: oui
	Off: non
	Seed: Graine
	Mode: Mode
	Network: Partie
	SinglePlayer: solo
	Multiplayer: multijoueur
	Tier: Tier débloqué
	Limit: Tier max autorisé
	Gating: Blocage
	Pool: Objets randomisables / protégés / exclus
	Snapshots: Tables de loot ennemis / sacs
	Findable: Trouvable dès le tier {0}, obtenable (avec craft) dès le tier {1}
	GuaranteedOn: Drop garanti de : {0}
	GuaranteedTag: (garanti)
	Individual: "{0} : vie x{1}, dégâts x{2}, défense x{3}, taille x{4} ; bonus de loot x{5}"
	Adaptive: Puissance adaptative : vie x{0}, dégâts x{1} (compris ci-dessus)
	Power: Puissance adaptative
	PowerStats: puissance {0}, écart {1} tiers : ennemis vie x{2} dégâts x{3}, boss vie x{4} dégâts x{5}
	KindNormal: Normal
	KindGiant: Géant
	KindMini: Mini
	Swaps: Remplacements
	SwapStats: "{0} repérés : {1} ennemis et {2} critters remplacés ; {3} non remplaçables, {4} gardés par le hasard, {5} sans remplaçant, {6} dans des lieux pas encore ouverts"
	Recipes: Recettes
	Shimmer: Shimmer
	Chests: Coffres
	SetTier: Régler la progression (boss vaincus) au tier :
	NewSeed: Nouvelle graine
	PoolTable: Objets par catégorie, tiers 0 à 9 :
	TierSet: Progression réglée sur {0}.
	SeedSet: Nouvelle graine : {0}.
	HoverItem: Objet sous la souris (ou en main)
	NoItem: Survole un objet ou tiens-en un.
	ItemInfo: Catégorie {0}, tier {1} ({2}), protégé {3}, exclu {4}, stack {5}-{6}, valeur {7}
	ShufflePartner: Partenaire du mélange garanti : {0}
	NearestNpc: PNJ le plus proche de la souris
	NoNpc: Aucun PNJ près de la souris.
	NpcTier: tier {0} (tirages : {1})
	Multipliers: Multiplicateurs : vie x{0}, dégâts x{1}, défense x{2}, taille x{3}
	Swappable: Peut être remplacé par les ennemis aléatoires.
	NotSwappable: Jamais remplacé par les ennemis aléatoires.
	Drops: Loot dans ce monde :
	NoDrops: Ne donne rien dans ce monde.
	ExtraTag: (en plus)
	ConditionTag: (conditions)
	Player: Joueur
	GodMode: Invincible
	SpawnRate: Apparitions
	SpawnRateNormal: normales
	SpawnRateNone: aucune
	SpawnRateHigh: beaucoup
	ToggleGodMode: Invincible oui/non
	CycleSpawnRate: Taux d'apparition
	GiveKit: Kit de test
	GiveEndgameKit: Kit de fin de jeu
	World: Monde
	Day: jour
	Night: nuit
	SpawnEnemies: Faire apparaître 5 ennemis
	KillHostiles: Tuer les ennemis à l'écran
	ToggleDay: Jour/nuit
	GiveBags: Tous les sacs de boss
	OpenJournal: Codex
	ToolsHelp: Astuce : onglet Inspecteur + souris sur un ennemi = son loot ; tue-le pour comparer. Les ennemis invoqués apparaissent comme des naturels (les ennemis aléatoires s'appliquent).
	RunTests: Lancer tous les tests
	TestsHelp: Lance tous les tests automatiques dans le monde actuel. Les résultats vont aussi dans client.log.
	TestSummary: "{0} réussis, {1} échoués, {2} ignorés"
}

Tests: {
	NoWorld: Monde chargé
	PoolBuilt: Liste d'objets construite, chaque catégorie principale a des objets
	Classification: Les objets connus sont bien classés
	Determinism: Les tirages sont déterministes et dépendent de la graine
	GatingRespected: Aucun objet au-dessus du tier autorisé (blocage par progression)
	NoProtectedRolled: Les objets protégés et exclus ne sont jamais donnés au hasard
	SameCategory: Les remplaçants gardent la catégorie
	ShuffleBijection: Mélange garanti : chaque objet obtenable est donné exactement une fois
	StackRules: Les tailles de stack sont valides
	PriceFloor: Les prix des boutiques ne sont jamais sous la valeur de l'objet
	DropRates: Les taux de drop sont valides
	SnapshotsCaptured: Les tables de loot d'origine ont été lues
	MobPlansValid: Toutes les tables de loot des ennemis sont valides
	LootAbundanceScales: L'abondance du butin multiplie les drops des ennemis, pas les drops garantis
	DropTableLength: Les ennemis ont de longues tables de loot (2 à 7 emplacements : environ 1,85 fois les anciens 1 à 4)
	JackpotUseful: Les jackpots sont toujours des objets utiles
	JackpotNotInEnemyDrops: Les jackpots ne comptent pas parmi les drops de l'ennemi
	JackpotRatesLower: Les jackpots sont un peu plus rares par défaut
	JackpotDropsMarked: Les drops au-delà de la limite sont marqués comme jackpots
	GiantBonusUseful: L'objet bonus d'un géant est utile, avec cinq fois plus de chances d'être un jackpot
	MiniBonusDrop: Les minis et les géants donnent un objet bonus, jamais les sbires de boss
	JackpotWorthScales: Les ennemis faibles ont une part des chances de jackpot qui suit leur vie (0,1 à 1)
	SpawnedEnemyNoExtraDrops: Les ennemis engendrés par un autre ennemi ne donnent ni drop en plus, ni drop garanti, ni jackpot
	CrittersNoJackpot: Les bestioles ne donnent jamais de jackpot
	ProtectedDropsKept: Les drops de progression sont conservés
	NoMinionFarms: Les minions de boss et les PNJ n'ont pas de drops aléatoires
	EventItemsKept: Objets de l'Armée de l'Ancien et segments de boss préservés
	SwapSurvivesVariantSetDefaults: Les variantes d'ennemis (Pinky, zombies) sont bien remplacées
	CritterSwapLive: Les critters sont vraiment remplacés, dans le même habitat
	CritterPoolSafe: Aucun critter doré, Chrysope prismatique, Ver truffe ou critter de lave ne peut en remplacer un autre
	CritterHabitat: Les critters aquatiques, volants et terrestres restent dans leur habitat
	SwapStatsCount: Les apparitions naturelles sont comptées, celles des statues ignorées
	CodexRecordsLoot: Le codex enregistre l'ennemi tué et chaque objet lâché par un slime
	CodexRecipesFromGuide: Le Guide fait découvrir les recettes qui utilisent l'objet et celles qui le donnent
	CodexSaveLoad: Le codex est sauvegardé et rechargé avec le monde sans rien perdre
	CodexSyncRoundTrip: Les découvertes du codex passent le format réseau intactes (différences et synchro complète)
	CodexUiBuilds: Interface du codex : chaque onglet et chaque fiche d'objet, d'ennemi et d'arbre d'artisanat se construit
	CodexHidesUndiscovered: Interface du codex : recettes, ennemis, objets et sacs non découverts restent cachés
	CodexManyItemsBounded: Interface du codex : avec 3000 objets et 300 ennemis, seules les lignes visibles sont construites
	CodexTextsResolved: Interface du codex : aucune clé de texte brute n'est affichée
	CodexShowsChances: Interface du codex : le butin découvert affiche sa chance prévue, les biomes la part des apparitions
	BiomeSlotsReachable: Par biome : chaque lieu d'apparition d'un ennemi qui en a plusieurs peut être atteint
	NegativeNetIdSwap: Le remplacement par une couleur de slime (Pinky) fonctionne et garde le type Slime bleu
	EvilSlotsShared: Par biome : dans un monde à un seul mal, les ennemis des lieux du mal absent apparaissent dans le mal présent (20 graines)
	BiomeRedistributionComplete: Par biome : chaque ennemi naturel garde son nombre de lieux d'apparition, dans sa classe et sa paire de tiers, jamais plus d'un tier au-dessus du lieu (20 graines)
	BiomeSlotsRespectDaylight: Par biome : aucun ennemi qui fuit ou meurt au soleil (Gnome) dans un lieu de surface de jour
	BiomeExtrasShare: Par biome : 8 % des lieux d'apparition sont partagés avec des ennemis d'événement
	CriticalHostsInForest: Par biome : les stations de base tombent d'ennemis de la Forêt du début
	SurpriseZero: Avec 0 % de surprise, les objets remplacés gardent leur catégorie
	SurpriseHundred: Avec 100 % de surprise, les catégories suivent les poids du loot
	SurpriseGatedAndProtected: Les surprises respectent la progression et les objets protégés
	RecipeSurpriseRate: La part de recettes qui changent de catégorie suit le réglage
	WeightTablesSeparated: Les poids du loot favorisent l'équipement, ceux des ingrédients jamais
	TierWindowVariety: Les tirages de début de partie donnent beaucoup d'objets différents
	OreMappingBijective: Chaque minerai du monde existe encore, comme drop d'un seul autre minerai du monde ; les minerais absents restent eux-mêmes, et le choix d'une paire hardmode ne change aucun minerai d'un autre palier ; un pour un même quand les deux minerais d'une paire sont présents
	TreeShakeReplacement: Les arbres secoués donnent des objets aléatoires et gardent les glands
	HerbReplacementTable: Chaque herbe a un ensemble fixe de remplaçants valides
	ExtractinatorRules: L'Extractinator garde les pièces et échange les minerais contre des minerais
	AnglerRewardsValid: Les récompenses du Pêcheur sont des objets valides, pièces conservées
	TreeCritterSwap: Les critters qui tombent des arbres sont aussi remplacés
	PacingExpected: 15 à 25 pièces d'équipement aléatoires par heure en début de partie (réglages par défaut ; valeur écrite dans client.log)
	PacingSimulation: La simulation du rythme est stable et régulière
	PacingVariety: Au moins 10 pièces d'équipement différentes par heure en début de partie
	DropFrequency: La plupart des kills donnent quelque chose (au moins 0,6 objet par kill ; valeur écrite dans client.log)
	WorkBenchPacing: Le premier établi arrive après 15 à 30 minutes en moyenne (valeur écrite dans client.log)
	BasicStationsUnprotected: Les stations de base (établi, fourneau, enclume...) sont confiées au randomizer
	ProgressionStationsProtected: Les stations de progression et thématiques sont protégées, sauf si la protection des stations vaut Aucune
	ProgressionStationsGuaranteed: Les stations de progression et les invocations de boss non protégées tombent d'ennemis fréquents de leur palier (1 % ou plus)
	WorldSummonsProtected: Les invocations trouvées dans le monde restent protégées, celles qu'on fabrique sont randomisées
	BasicStationsFindable: Chaque station de base se trouve dès le début (ennemis et pots)
	GuaranteedReachability: Chaque objet garanti est porté par des ennemis naturels de son tier
	GuaranteedBiomeHosts: Chaque objet garanti est porté par au moins 3 ennemis d'un même biome, avec la même chance sur chacun
	GuaranteedSeveralSeeds: Chaque objet garanti obtient les ennemis d'un biome avec d'autres graines
	GuaranteedBiomesSpread: Les objets garantis d'un tier sont répartis sur plusieurs biomes
	GuaranteedFindTime: Chaque station, invocation et outil garanti tombe en environ 90 ennemis tués dans son biome
	HintSortedByProgress: Les indices sont triés par avancement, en deux onglets
	HintFoundUnlocks: L'indice d'un objet trouvé est entièrement connu, gratuitement
	HintClickOpensCodex: Cliquer sur un indice ouvre la bonne page du codex
	HintTreeComplete: Un indice de recette donne la source de chaque ingrédient et station, jusqu'aux matières premières
	HintTreeDeterministic: Les arbres des indices de recette sont les mêmes après reconstruction
	HintTabsSplit: Les indices du Guide sont répartis entre artisanat et boss
	HintTreeKeepsOtherHints: Un arbre d'indice cache les stations et invocations des autres indices tant qu'ils ne sont pas connus
	GuaranteedHostsNotEvents: Les drops garantis ne sont jamais sur des ennemis d'invasion, de lune, saisonniers ou météo
	GuaranteedDeterminism: Les sources garanties sont identiques après reconstruction
	FindabilityDeterminism: La trouvabilité des objets est identique après reconstruction
	WorldMaterialsFindable: Bois, pierre, gemmes et premiers minerais se trouvent dès le début
	BagContentFindable: Le contenu d'un sac ne compte comme trouvable que si le sac peut être obtenu (jamais les sacs saisonniers, les sacs de trésor seulement en mode expert)
	CrateAccessWorld: Les caisses que le monde ne peut pas donner (autre mal, caisse sacrée avant le hardmode) ne comptent pas comme source
	HardmodeOresOfWorld: Les minerais des paires hardmode comptent toujours comme trouvables et ne deviennent jamais de nouveaux ingrédients
	AltarDecisionKeepsCaches: Le choix d'un minerai hardmode par un autel ne change ni les sources garanties ni la trouvabilité
	IngredientReplacementsFindable: Les ingrédients remplacés se trouvent (sans craft) au niveau de la recette
	RecipesDoable: Au moins 85 % des recettes randomisées sont faisables à leur niveau
	AvailabilityConsistent: La disponibilité prévue des objets correspond à un recalcul indépendant sur les recettes appliquées
	NoSelfIngredient: Aucune recette n'utilise son propre résultat
	ResultNotInGroup: Aucune recette randomisée ne donne un objet accepté par son propre groupe d'ingrédients
	IngredientValueCoherent: Les ingrédients remplacés gardent à peu près la même valeur
	ProtectedIngredientsKept: Les ingrédients protégés (matériaux de progression...) ne sont jamais remplacés
	RecipeGroupsSane: Chaque groupe de recette (n'importe quel bois, lingot de fer...) garde son ingrédient
	RecipePlanDeterminism: Ingrédients et stations identiques après reconstruction
	UntouchedRecipesIntact: Les recettes protégées gardent leurs ingrédients et stations
	DecraftSafeWithIngredients: Le décraft au Shimmer ne rend jamais des ingrédients plus précieux
	VanillaModeGuaranteed: En mode ingrédients vanilla, chaque ingrédient manquant est placé sur des ennemis
	StationDag: Aucune station de craft n'a besoin d'elle-même pour être fabriquée, directement ou via d'autres stations
	StationTierRespected: Les recettes ne demandent jamais de station au-dessus de leur niveau, ni de station thématique
	HandCraftKept: Les recettes à la main restent à la main
	StationsVaried: Une bonne part des recettes a changé de station
	AppliedResultsMatchPlan: Les recettes donnent les résultats prévus par le planificateur, et sa disponibilité correspond aux recettes en jeu
	StationPlanFromOriginals: Le choix des stations ne dépend que des recettes d'origine, pas de celles déjà randomisées
	RealCrafting: Le menu d'artisanat propose une recette avec ses nouveaux ingrédients, et plus avec les anciens
	PickaxePerMiningLevel: Chaque niveau de minage a une pioche au tier de ses minerais (fabriquée, trouvée ou garantie)
	RecipeRandomizationShare: La plupart des recettes vanilla changent de résultat (85 %), ou de résultat ou d'ingrédients (95 %) ; les raisons sont journalisées
	RecipeValueFallback: Le repli de valeur donne un objet de la catégorie et du tier de l'original, abordable, sinon le moins cher
	CraftedValueFromIngredients: Un objet fabriqué avec une recette randomisée se revend au plus au prix de ses ingrédients, même après sauvegarde, réseau, division et empilement
	FurnitureSurprise: Les recettes de meubles, de blocs et de murs donnent autre chose selon la chance de surprise des meubles
	ProtectedRecipesDoable: Les recettes des stations de progression et des objets protégés sont faisables à leur niveau
	BellCurveShape: Les stats des ennemis suivent une cloche : surtout normales, quelques % loin de la normale
	BellCurveBounds: Les stats tirées restent toujours dans leur plage
	ExtremenessEffect: Le réglage de rareté rend les valeurs extrêmes plus rares
	GiantMiniFrequency: Géants et minis apparaissent aussi souvent que réglé
	GiantMiniBounds: Les tailles des géants et minis restent dans leur plage
	GiantHitboxCap: Les géants ne dépassent jamais la taille maximale autorisée
	IndividualSyncRoundTrip: Les stats individuelles (géant, mini...) arrivent intactes chez les clients en multijoueur
	ClientIndividualLife: Les géants et les minis ont la bonne vie maximale chez les clients en multijoueur, sans écraser leur vie synchronisée
	NoGiantMinions: Les minions de boss ne sont jamais géants ni minis et ne donnent jamais le drop bonus des géants
	TransformRerollsIndividual: Les ennemis remplacés reçoivent leurs propres stats individuelles
	VariantGetsIndividual: Un ennemi changé en variante (Pinky...) garde ses propres stats individuelles et sa proportion de vie
	TransformKeepsIndividual: Une transformation vanilla garde les stats individuelles de l'ennemi (pas de géant qui clignote) et sa proportion de vie
	StatCacheBossFlag: Les multiplicateurs d'un boss ne dépendent pas d'une lecture antérieure du même type comme non-boss
	LootBonusCap: Le bonus de loot augmente avec la force et reste sous son plafond
	LootBonusApplied: Les ennemis plus forts reçoivent un bonus de loot
	DamageCapRespected: Les multiplicateurs de dégâts des ennemis restent sous le plafond total
	AdaptivePowerMeasured: La puissance du joueur vient de la meilleure arme, de l'armure portée et des 3 meilleurs accessoires
	AdaptiveFormula: Les multiplicateurs adaptatifs grandissent avec l'écart, sont plafonnés et jamais sous x1
	AdaptiveAppliedAtSpawn: Les ennemis reçoivent les multiplicateurs adaptatifs à leur apparition
	AdaptiveBossParts: Les parties de boss sont renforcées comme leur boss
	AdaptiveNotCompounded: Un ennemi transformé garde ses multiplicateurs adaptatifs sans les cumuler
	BagPlansValid: Tous les contenus de sacs sont valides
	BagsKeepCoins: Les sacs de boss gardent leurs pièces
	CrittersDrop: Les critters reçoivent leur part du petit drop fréquent
	WildTail: La queue de folie donne la part prévue au-delà de la limite, plus rare à chaque palier
	PlansIgnoreWild: Les plans, la trouvabilité et les garanties ne dépendent pas de la queue de folie
	RecipesSafe: Recettes : pas d'ingrédient identique au résultat, garde-fou respecté
	MiningProtected: Les recettes de pioches et de lingots ne changent pas
	DecraftSafe: Le décraft au Shimmer ne peut pas dupliquer d'objets
	ShimmerCoherent: Les transformations du Shimmer gardent catégorie et valeur
	ShopSimulation: Boutique simulée : pas de doublons, prix justes, cases spéciales intactes
	EnemySwapPool: Ennemis aléatoires : ni morceaux de boss, ni minions, ni ennemis d'événement
	EnemySwapDaylight: Ennemis aléatoires : rien qui fuit le jour, de jour
	TownOrderPermutation: L'ordre des PNJ est une permutation valide
	EnemyStatRanges: Les multiplicateurs des boss restent dans les limites
	ConfigTexts: Chaque réglage a un texte
	OtherTexts: Chaque message a un texte
	ConfigRanges: Les réglages sont cohérents
	DebugToolsDefaultOff: Les outils de débogage sont désactivés par défaut
	CacheSignatureScope: Sauvegarder un réglage de stats d'ennemis garde la trouvabilité et le plan des recettes ; les réglages de butin et du pool d'échanges les recalculent
	ConfigResetDefaults: Réglages : le bouton de réinitialisation remet chaque valeur par défaut, sur toutes les pages
	HintFactsTrue: Les indices disent ce que prévoient les planificateurs : l'hôte porte l'objet, la recette le fabrique
	HintPriceScales: Le prix des indices suit la formule et monte avec le niveau et le palier
	HintPurchaseFlow: Acheter un indice prend les pièces, monte son niveau, et est refusé sans assez de pièces
	HintSyncRoundTrip: Les niveaux d'indice survivent au format réseau du codex, à la sauvegarde et aux vérifications du serveur
	HintTextsResolved: Chaque phrase d'indice est une vraie phrase dans cette langue
	HintSourceFrequent: Les indices de créature mènent à des ennemis fréquents (5 % d'un biome ou plus, ensemble pour un objet garanti) avec 1 % de chances ou plus
	HintTargetsHaveSource: Chaque station et invocation garantie a un indice de créature ou de recette, jamais une source rare de secours
	HintBiomeEveryLevel: Les niveaux 2 à 4 d'un indice de créature nomment son meilleur biome
	HintRevealDiscovers: Le dernier niveau d'un indice révèle ses ennemis dans le codex (page, butin, biome), sauvegardé et synchronisé
	HintHostsNamed: L'indice d'un objet garanti nomme chaque ennemi de son biome qui le porte, avec la chance sur chacun
	PlannedShareSums: Les parts d'apparition prévues de chaque biome font 100 %, les ennemis rares en ont moins
}

Journal.Description: Ouvre le codex du randomizer (aussi avec la touche J)

Jackpot: {
	Popup: Jackpot ! +{0}
	PopupBig: JACKPOT !!! +{0}
	Chat: Jackpot ! {0} : {1} palier(s) d'avance sur ta progression ({2})
	Tooltip: Jackpot : {0} palier(s) d'avance sur ta progression ({1})
}

Codex: {
	Title: Codex du randomizer
	TabEnemies: Ennemis
	TabItems: Objets
	TabCrafts: Arbre d'artisanat
	TabBags: Sacs
	TabBiomes: Biomes
	TabHints: Indices
	Search: Rechercher...
	Empty: Rien de découvert ici pour l'instant : tue des ennemis, ouvre des coffres et des sacs, regarde les recettes !
	NoMatch: Rien ne correspond à la recherche.
	Error: Impossible d'afficher cette page (voir client.log).
	Loading: Chargement...
	EnemiesCount: Ennemis vaincus : {0}
	Kills: Vaincus : {0}
	Tier: Palier {0}
	Life: Vie de base : {0}
	SeenTimesIn: Vu {0} fois, dans :
	SpawnShareHover: Part de cet ennemi parmi les apparitions vues dans ce biome
	ChanceHover: Chance prévue par ennemi vaincu (le bonus de butin des ennemis renforcés peut l'augmenter)
	ChanceUnknown: ?
	Percent: "{0} %"
	DropsFound: Butin trouvé
	NoDrops: Rien obtenu pour l'instant.
	ToFind: Butin encore à trouver : {0}
	UnknownDrop: Butin inconnu : continue la chasse !
	FilterCategory: Catégorie : {0}
	FilterTier: Palier : {0}
	ItemsCount: "{0} / {1} objets"
	CraftedWith: Fabriqué avec
	UsedIn: Sert à fabriquer
	DroppedBy: Lâché par
	OtherSources: Autres sources
	BagContents: Obtenu dans ce sac
	NoSource: Aucune source trouvée pour l'instant.
	More: ... et {0} de plus
	OpenTree: Arbre d'artisanat
	ItemPage: Fiche de l'objet
	At: sur
	PickItem: Choisis un objet pour voir comment le fabriquer (recettes découvertes uniquement).
	TreeOf: Fabriquer : {0}
	Cycle: (déjà plus haut)
	TooDeep: (trop profond)
	TreeTooBig: L'arbre est trop grand : replie quelques branches.
	NothingReceived: Rien obtenu pour l'instant.
	SeenCount: "{0} ennemis vus"

	Biome: {
		Forest: {
			Name: Forêt
			Description: La surface hors des autres biomes, autour du point de départ
		}

		Snow: {
			Name: Neige
			Description: Les terres gelées de la surface
		}

		Desert: {
			Name: Désert
			Description: Les sables de la surface, oasis comprises
		}

		Jungle: {
			Name: Jungle
			Description: La surface de la jungle, faite de boue et d'acajou
		}

		Ocean: {
			Name: Océan
			Description: Les plages et la mer, aux deux bords du monde
		}

		Corruption: {
			Name: Corruption
			Description: La surface de la Corruption et ses gouffres
		}

		Crimson: {
			Name: Carmin
			Description: La surface du Carmin, rouge et charnue
		}

		Hallow: {
			Name: Sacré
			Description: La surface du Sacré, qui apparaît en mode difficile
		}

		Mushroom: {
			Name: Champignons lumineux
			Description: Un champ de champignons lumineux à la surface
		}

		Graveyard: {
			Name: Cimetière
			Description: Autour d'un amas de pierres tombales, sous un ciel brumeux
		}

		Meteor: {
			Name: Météorite
			Description: Autour d'une météorite tombée
		}

		Sky: {
			Name: Ciel (îles flottantes)
			Description: Très haut au-dessus de la surface, parmi les îles flottantes
		}

		Underground: {
			Name: Souterrain (couche de terre)
			Description: La couche de terre, juste sous la surface
		}

		Caverns: {
			Name: Cavernes
			Description: Les grottes de pierre profondes, entre la couche de terre et l'Enfer
		}

		UndergroundSnow: {
			Name: Grottes de glace
			Description: Sous la neige : les grottes de glace
		}

		UndergroundDesert: {
			Name: Désert souterrain
			Description: Sous le désert : les grottes de grès
		}

		UndergroundJungle: {
			Name: Jungle souterraine
			Description: Sous la jungle : les grottes de boue
		}

		UndergroundCorruption: {
			Name: Corruption souterraine
			Description: La Corruption sous la surface
		}

		UndergroundCrimson: {
			Name: Carmin souterrain
			Description: Le Carmin sous la surface
		}

		UndergroundHallow: {
