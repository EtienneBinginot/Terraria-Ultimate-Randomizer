	GeneralConfig: {
		DisplayName: 1. Général

		Headers: {
			Mode: Mode
			Seed: Graine
			Exclusions: Exclusions
		}

		RandomizerMode: {
			Label: Mode du randomizer
			Tooltip:
				'''
				Chaos : n'importe quoi peut venir de n'importe où (comme le tRandomizer d'origine).
				Cohérent : aléatoire, mais les catégories et les tiers sont respectés, et les objets se débloquent avec la progression.
				Mélange garanti : chaque objet est échangé avec un autre de même catégorie et de même tier, tout reste obtenable.
				'''
		}

		SeedSource: {
			Label: Graine des nouveaux mondes
			Tooltip:
				'''
				Aléatoire : chaque monde a sa propre graine.
				Depuis la seed du monde : deux mondes créés avec la même seed ont la même randomisation.
				Fixe : tous les nouveaux mondes utilisent la graine fixe ci-dessous.
				'''
		}

		FixedSeed: {
			Label: Graine fixe
			Tooltip: Utilisée quand la source de la graine est « Fixe ».
		}

		AllowSeedChange: {
			Label: Autoriser /rseed à changer la graine
			Tooltip: L'hôte (ou le joueur en solo) peut changer la graine du monde avec /rseed set ou /rseed random.
		}

		ExcludedItems: {
			Label: Objets exclus
			Tooltip: Ces objets ne sont jamais randomisés et jamais donnés comme objet aléatoire.
		}

		ExcludedMods: {
			Label: Mods exclus
			Tooltip: Noms internes des mods dont les objets sont ignorés par le randomizer (par exemple CalamityMod).
		}

		ResetAll: {
			Label: Réinitialiser tous les réglages (cliquer deux fois)
			Tooltip: Remet chaque réglage d'Ultimate Randomizer (toutes les pages, réglages client compris) à sa valeur par défaut. Cliquez, puis cliquez à nouveau dans les secondes qui suivent pour confirmer. Dans un monde, les réglages qui demandent un rechargement sont conservés : réinitialisez depuis le menu principal pour les remettre aussi. En multijoueur, seul l'hôte peut le faire.
		}
	}

	ProgressionConfig: {
		DisplayName: 2. Progression et protection

		Headers: {
			TierGating: Déblocage des objets avec la progression
			Protection: Objets de progression protégés
			Tiers: Tiers
			Guarantees: Sources garanties
			AdaptivePower: Puissance adaptative
		}

		TierGating: {
			Label: Bloquer les objets selon la progression
			Tooltip:
				'''
				Les objets d'un tier pas encore débloqué (boss vaincus) sont remplacés par un objet du tier le plus haut autorisé,
				jusqu'à ce que tu progresses. Évite d'avoir le Zenith sur le premier slime.
				'''
		}

		TierAllowance: {
			Label: Tiers autorisés au-dessus de ta progression
			Tooltip: 0 = seulement les tiers déjà débloqués. 2 = deux tiers d'avance (par défaut), etc. La puissance adaptative renforce les ennemis si ton équipement prend de l'avance sur le monde.
		}

		JackpotTierChance: {
			Label: Chance de jackpot (%)
			Tooltip: Chance qu'un emplacement de drop vise 2 ou 3 tiers plus haut que normal. Le blocage par progression s'applique quand même.
		}

		RuntimeJackpotChance: {
			Label: Chance de drop chanceux (%)
			Tooltip: Chance, à chaque kill, d'ignorer le blocage par progression et d'obtenir directement le vrai objet. Au-delà de la limite, c'est un jackpot : toujours un équipement utile ou une station d'artisanat, signalé par de la lumière et un son. Les ennemis faibles (moins de vie que d'habitude à leur niveau) ont moins de chances, les bestioles et les ennemis engendrés par un autre ennemi aucune.
		}

		WildDropChance: {
			Label: Folie : drops au-delà de la limite (%)
			Tooltip: Part des drops aléatoires des ennemis et des sacs qui dépassent la limite de progression, à tout moment. Chaque palier plus haut est plus rare (voir le réglage suivant) : un Zénith en début de partie est possible, mais rarissime. Ces jackpots sont toujours utiles (équipement, stations de progression), d'autant plus visibles qu'ils sont hauts, et ne comptent pas parmi les drops de l'ennemi. Les ennemis s'adaptent ensuite à votre équipement (puissance adaptative). Les ennemis faibles en ont une part moindre, les bestioles et les ennemis engendrés par un autre ennemi aucune. 0 = progression classique.
		}

		WildTierDecay: {
			Label: Folie : rareté par palier en plus
			Tooltip: À quel point chaque palier au-delà de la limite est plus rare pour les drops de folie : 4 (par défaut) = un palier au-dessus est 4 fois plus fréquent que deux paliers au-dessus. Plus haut = la folie reste plus près de la limite.
		}

		MechTierRequiresAllThree: {
			Label: Le tier mécanique demande les trois boss mécaniques
			Tooltip: Désactivé : un seul boss mécanique suffit pour débloquer le tier.
		}

		ScaleWeakEnemiesWithProgression: {
			Label: Les ennemis faibles suivent ta progression
			Tooltip: Activé : les ennemis du début donnent des objets proches de ton tier actuel au lieu de rester à leur niveau.
		}

		AdaptivePower: {
			Label: Les ennemis s'adaptent à ton équipement
			Tooltip: Les objets puissants peuvent arriver tôt, mais les ennemis et les boss deviennent alors plus forts : chaque tier de puissance au-dessus de la progression du monde multiplie leur vie et leurs dégâts à leur apparition (les boss sont remesurés pendant le combat). Les ennemis ne s'affaiblissent jamais. Puissance = meilleure arme portée sur toi, inventaire et coffre du néant (50 %), armure (25 %) et 3 meilleurs accessoires (25 %), les meilleurs entre l'équipement porté et les configurations d'équipement.
		}

		AdaptiveGrace: {
			Label: Tiers de puissance gratuits
			Tooltip: Tiers de puissance au-dessus de ta progression qui ne renforcent pas encore les ennemis.
		}

		LifeGrowthPerTier: {
			Label: Vie des ennemis par tier de puissance
			Tooltip: Multiplicateur de vie des ennemis pour chaque tier de puissance en trop (cumulé à chaque tier).
		}

		DamageGrowthPerTier: {
			Label: Dégâts des ennemis par tier de puissance
			Tooltip: Multiplicateur de dégâts des ennemis pour chaque tier de puissance en trop (cumulé à chaque tier). Volontairement bas : la défense est soustraite des dégâts, c'est donc la vie qui fait l'essentiel de la hausse.
		}

		BossLifeGrowthPerTier: {
			Label: Vie des boss par tier de puissance
			Tooltip: Pareil pour les boss et leurs parties, qui répondent au joueur le plus fort.
		}

		BossDamageGrowthPerTier: {
			Label: Dégâts des boss par tier de puissance
			Tooltip: Pareil pour les dégâts des boss, de leurs parties et de leurs projectiles.
		}

		AdaptiveCap: {
			Label: Multiplicateur de vie maximum
			Tooltip: La puissance adaptative ne multiplie jamais la vie des ennemis par plus que ça.
		}

		AdaptiveDamageCap: {
			Label: Multiplicateur de dégâts maximum
			Tooltip: La puissance adaptative ne multiplie jamais les dégâts des ennemis par plus que ça (le plafond de dégâts totaux des réglages ennemis s'applique aussi).
		}

		ProtectedItems: {
			Label: Objets protégés
			Tooltip: Jamais remplacés (drops, recettes...) et jamais donnés comme objet aléatoire. Garantit que la progression reste possible. Les invocations de boss fabriquées ne sont plus dans la liste par défaut : des ennemis courants les lâchent à coup sûr (réinitialisez la liste pour avoir la nouvelle valeur par défaut).
		}

		ProtectProgressionMaterials: {
			Label: Protéger les matériaux de progression
			Tooltip: Écailles d'ombre, échantillons de tissu, lingots sacrés, âmes mécaniques, fragments lunaires, luminite, ectoplasme et clés de biome ne sont jamais randomisés.
		}

		AutoProtectBossSummons: {
			Label: Protéger toutes les invocations de boss
			Tooltip: Désactivé : les invocations de boss fabriquées ou lâchées (Œil à l'air suspect, Poupée vaudou du guide, invocations mécaniques...) sont randomisées, et des ennemis courants de leur palier les lâchent à la place. Les invocations trouvées dans le monde (Ver truffe, Capsule de pouvoir Lihzahrd, Cristal de gélatine, Chrysope prismatique) restent protégées, tout comme les invocations des autres mods. Activé : toutes les invocations de boss sont protégées.
		}

		StationProtection: {
			Label: Protection des stations de craft
			Tooltip: Aucune : toutes les stations sont randomisées, y compris celles de progression (Forge d'enfer, enclumes et forges hardmode, Atelier de bricolage, Manipulateur antique...) ; des ennemis courants de leur palier lâchent chacune d'elles. Progression seulement : seules les stations de base (établi, fourneau, enclume, table, chaise, scierie, métier à tisser...) sont randomisées ; on les trouve aussi dans les pots et les coffres en bois. Les stations des autres mods restent protégées.
		}

		ProtectPickaxeProgression: {
			Label: Protéger la progression du minage
			Tooltip: Activé : les recettes de pioches et de lingots ne sont jamais randomisées. Désactivé : elles le sont, et une pioche assez puissante pour chaque nouveau minerai est garantie sur des ennemis communs quand les recettes n'en donnent pas à temps. Les minerais minés ne deviennent que d'autres minerais du même tier.
		}

		GuaranteedDropMultiplier: {
			Label: "Multiplicateur des drops garantis"
			Tooltip: "Les stations de base (et les ingrédients vanilla, si choisis) sont placées sur les ennemis courants d'un biome de leur tier. Augmente pour les trouver plus vite."
		}

		GuaranteedHostsPerItem: {
			Label: "Ennemis portant chaque objet garanti"
			Tooltip: "Chaque objet garanti (stations, invocations de boss, pioches, ingrédients nécessaires) est placé sur les ennemis d'un biome de son tier, les plus fréquents d'abord, jusqu'à ce nombre. Les indices les nomment tous."
		}

		StationFindKills: {
			Label: "Ennemis tués dans son biome pour trouver une station"
			Tooltip: "Nombre moyen d'ennemis tués dans son biome avant qu'une station, une invocation de boss ou une pioche garantie tombe, tous ses ennemis confondus. Les pots et les coffres en bois aident aussi. L'établi et les premières stations suivent plutôt la première heure de jeu."
		}

		PotGuaranteeChance: {
			Label: Objets garantis dans les pots (%)
			Tooltip: Chance qu'un pot donne aussi un des objets garantis déjà débloqués.
		}

		ChestStationGuarantee: {
			Label: Stations de base dans les coffres en bois
			Tooltip: Exemplaires de chaque station de base cachés dans des coffres en bois à la création du monde (ou avec /rchests).
		}

		MinFindableChance: {
			Label: Chance minimale pour être trouvable (%)
			Tooltip: Un drop compte comme moyen de trouver un objet (pour choisir les ingrédients des recettes) si sa chance est au moins celle-ci.
		}

		TierOverrides: {
			Label: Tiers forcés
			Tooltip: Force le tier de certains objets (utile pour les objets des autres mods).
		}
	}

	TierOverride: {
		Tooltip: ""

		Item: {
			Label: Objet
			Tooltip: ""
		}

		Tier: {
			Label: Tier
			Tooltip: ""
		}
	}

	LootConfig: {
		DisplayName: 3. Loot

		Headers: {
			Mobs: Ennemis et boss
			Bags: Sacs et caisses
			World: Monde : coffres, pêche, minage
			Variety: Variété
		}

		RandomizeMobDrops: {
			Label: Randomiser le loot des ennemis et des boss
			Tooltip: Chaque objet lâché par un ennemi est remplacé par un objet de même catégorie, avec la chance et les conditions d'origine. Les objets de progression, les pièces et les sacs de trésor sont conservés.
		}

		DropTableStyle: {
			Label: Drops supplémentaires
			Tooltip: En plus des drops d'origine remplacés. Façon vanilla : chaque type d'ennemi a un nombre aléatoire de drops en plus (souvent peu, parfois beaucoup) avec des taux comme le jeu de base (1/1 pour les matériaux, 1/50 pour l'équipement...). Simple : chaque emplacement a la chance fixe ci-dessous. Miroir de l'original : aucun drop en plus, seulement les drops d'origine (remplacés).
		}

		EnemiesWithoutDropsCanDrop: {
			Label: Les ennemis sans drop reçoivent des drops
			Tooltip: Les ennemis qui ne donnent rien dans le jeu de base reçoivent aussi des drops aléatoires. Jamais les minions et morceaux de boss.
		}

		CrittersCanDrop: {
			Label: Les critters reçoivent des drops
			Tooltip: Lapins, oiseaux, papillons, insectes... reçoivent jusqu'à 2 drops aléatoires (plus avec l'abondance du butin) et une part du petit drop fréquent.
		}

		CritterDropFactor: {
			Label: Part du drop fréquent des critters
			Tooltip: Part du petit drop fréquent (matériau, potion, munitions...) que reçoivent les critters par rapport aux autres ennemis. Ils arrivent en nuées et meurent en un coup : 0,5 = deux fois moins souvent, 0 = jamais.
		}

		DropRateMultiplier: {
			Label: Multiplicateur de taux de drop
			Tooltip: Multiplie toutes les chances de drop (styles façon vanilla et miroir). 2 = deux fois plus de drops.
		}

		DropSlotsMin: {
			Label: Drops supplémentaires (minimum)
			Tooltip: Nombre de drops supplémentaires possibles d'un ennemi normal. Chaque type d'ennemi a son nombre fixe dans un monde, souvent proche du minimum.
		}

		DropSlotsMax: {
			Label: Drops supplémentaires (maximum)
			Tooltip: ""
		}

		DropChance: {
			Label: Chance de drop de chaque emplacement (%)
			Tooltip: Utilisé seulement par le style Simple. Les objets au-dessus du niveau de l'ennemi sont plus rares.
		}

		CommonDropChance: {
			Label: Petit drop fréquent (%)
			Tooltip: Chaque ennemi a aussi un petit drop fixe pour le monde (matériau, potion, munitions, nourriture, bloc ou minerai), avec cette chance. La plupart des kills donnent alors quelque chose.
		}

		LootAbundance: {
			Label: Abondance du butin
			Tooltip: Multiplie les drops aléatoires des ennemis : plus de drops supplémentaires, plus souvent, et plus de petits drops fréquents (au-delà de 100 %, des drops en plus). 2 = environ deux fois plus d'objets par kill qu'à 1 ; la valeur par défaut, 3, en donne environ trois fois plus. Les drops garantis (stations, objets de progression) ne changent pas.
		}

		BossDropSlotsMin: {
			Label: Drops supplémentaires des boss (minimum)
			Tooltip: En mode expert et maître, les boss qui ont un sac de trésor n'ont pas de drops en plus : c'est le contenu de leur sac qui est randomisé.
		}

		BossDropSlotsMax: {
			Label: Drops supplémentaires des boss (maximum)
			Tooltip: ""
		}

		DropCategoryWeights: {
			Label: Poids du loot
			Tooltip: Chance relative de chaque type d'objet pour tout ce qui donne des objets aléatoires (drops bonus, surprises). 0 = jamais. Les ingrédients des recettes ont leurs propres poids.
		}

		RandomizeBossBags: {
			Label: Randomiser les sacs de trésor
			Tooltip: Chaque objet du sac est remplacé par un objet de même catégorie et de même tier.
		}

		RandomizeCrates: {
			Label: Randomiser les caisses de pêche
			Tooltip: ""
		}

		RandomizeOtherBags: {
			Label: Randomiser les autres sacs
			Tooltip: Sacs de friandises, cadeaux, sacs d'herbes, géodes, boîtes de vers...
		}

		RandomizeChests: {
			Label: Randomiser les coffres des nouveaux mondes
			Tooltip: Chaque objet d'un coffre naturel est remplacé par un objet de même catégorie, à la création du monde. Pour les anciens mondes, utilise /rchests.
		}

		ChestTierBonus: {
			Label: Bonus de tier des coffres
			Tooltip: Rend le contenu des coffres meilleur de ce nombre de tiers.
		}

		RandomizeFishing: {
			Label: Randomiser la pêche
			Tooltip: Chaque poisson donne un autre objet de même catégorie et de même tier. Les poissons de quête ne changent jamais.
		}

		CratesStayCrates: {
			Label: Les caisses restent des caisses
			Tooltip: Les caisses pêchées ne sont pas remplacées (leur contenu est randomisé à l'ouverture).
		}

		RandomizeOreDrops: {
			Label: Randomiser les minerais minés
			Tooltip: Chaque minerai donne un autre minerai ou lingot du même tier (toujours le même dans un monde).
		}

		RandomizePotDrops: {
			Label: Randomiser le contenu des pots
			Tooltip: Les objets des pots sont remplacés par des objets de même catégorie. Les pièces et les coeurs ne changent pas.
		}

		RandomizeTreeShaking: {
			Label: Randomiser les arbres secoués
			Tooltip: Les fruits et objets qui tombent des arbres secoués sont remplacés (même type, ou une surprise).
		}

		KeepAcorns: {
			Label: Garder les glands
			Tooltip: Les arbres secoués donnent toujours des glands, pour pouvoir replanter.
		}

		RandomizeHerbs: {
			Label: Randomiser les herbes et plantes
			Tooltip: Les herbes, champignons, spores de la jungle et autres plantes donnent d'autres matériaux de leur tier. Les graines sont conservées.
		}

		HerbKeepChance: {
			Label: Herbes conservées (%)
			Tooltip: Chance qu'une herbe ou plante donne quand même son objet habituel.
		}

		HerbVariety: {
			Label: Objets par herbe
			Tooltip: Nombre d'objets différents que chaque herbe ou plante peut donner dans un monde.
		}

		RandomizeExtractinator: {
			Label: Randomiser l'Extractinator
			Tooltip: Les objets de l'Extractinator sont remplacés (les minerais par d'autres minerais du même tier). Les pièces sont conservées.
		}

		RandomizeAnglerRewards: {
			Label: Randomiser les récompenses du Pêcheur
			Tooltip: Les récompenses des quêtes de pêche du Pêcheur sont remplacées. Les pièces et appâts sont conservés.
		}

		SurpriseChance: {
			Label: Chance de surprise (%)
			Tooltip: Chance qu'un objet remplacé (drop, coffre, pot, sac, poisson...) devienne un objet de n'importe quelle catégorie, tiré avec les poids du loot, au lieu de garder son type. 0 = toujours le même type, 100 = n'importe quoi.
		}

		TierWindow: {
			Label: Fenêtre de tiers
			Tooltip: Les objets aléatoires sont aussi choisis parmi ce nombre de tiers en dessous de la cible. Plus de variété, surtout en début de partie.
		}
	}

