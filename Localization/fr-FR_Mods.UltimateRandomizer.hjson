	CraftingConfig: {
		DisplayName: 5. Craft et Shimmer

		Headers: {
			Recipes: Recettes
			Shimmer: Shimmer
			Ingredients: Ingrédients des recettes
			Stations: Stations de craft des recettes
		}

		RandomizeRecipes: {
			Label: Randomiser les recettes
			Tooltip: Reconstruit les recettes selon la graine : chacune garde son objet (quelques-unes l'échangent, voir plus bas) mais reçoit de nouveaux ingrédients et de nouvelles stations, faisables à son niveau. Les recettes redeviennent normales quand tu quittes le monde.
		}

		RandomizeModdedRecipes: {
			Label: Randomiser les recettes des autres mods
			Tooltip: Les recettes ajoutées par d'autres mods (Magic Storage...) sont randomisées comme celles du jeu : nouveaux ingrédients et stations, et parfois un résultat échangé. Chacune garde un ingrédient clé du niveau de son objet : une amélioration de stockage attend toujours ses lingots. Désactivé : elles restent telles que leur mod les a faites. Ajouter ou retirer des mods, ou changer ce réglage, modifie les résultats aléatoires de ce monde ; le désactiver ensuite ne rétablit pas les anciens.
		}

		LimitRecipeValue: {
			Label: Limiter la valeur des résultats
			Tooltip: Activé : quand l'objet d'une recette randomisée vaut plus de « Garde-fou de valeur » fois ses nouveaux ingrédients, ceux-ci sont relevés à la valeur des ingrédients vanilla. Désactivé : les nouveaux ingrédients ne suivent que de loin la valeur vanilla.
		}

		RecipeValueGuard: {
			Label: Garde-fou de valeur
			Tooltip: Quand « Limiter la valeur des résultats » est activé : un résultat vaut au plus ce nombre de fois ses ingrédients.
		}

		CraftedValueFromIngredients: {
			Label: Les objets fabriqués valent leurs ingrédients
			Tooltip: Un objet fabriqué avec une recette randomisée se revend au prix de ses ingrédients (jamais plus que son prix normal) : impossible de s'enrichir en fabriquant.
		}

		DisableDecraftOfRandomizedResults: {
			Label: Pas de décraft Shimmer des résultats aléatoires
			Tooltip: Empêche de dupliquer des objets en craftant un résultat aléatoire puis en le décraftant dans le Shimmer.
		}

		RecipeResultSwapChance: {
			Label: Chance d'échange de résultat (%)
			Tooltip: Part des recettes randomisées qui échangent leur résultat avec une autre recette du même palier, par paires (chaque objet reste fabricable, souvent par une recette inattendue). Une recette échangée reçoit des ingrédients dignes de l'objet qu'elle donne (son niveau, sa valeur), surtout des types qu'utilisait sa propre recette, avec une touche de ceux de l'objet.
		}

		IngredientMode: {
			Label: Ingrédients
			Tooltip: Randomisés : chaque recette est reconstruite à partir de matériaux trouvables ou fabricables à son niveau, en gardant seulement la forme générale de la recette vanilla (nombre et types d'ingrédients, valeur), avec au moins un ingrédient de son propre niveau. Vanilla : les ingrédients sont conservés et chacun est placé sur des ennemis du niveau de la recette.
		}

		IngredientWeights: {
			Label: Poids des ingrédients
			Tooltip: Chance relative de chaque type d'objet parmi les ingrédients d'une recette reconstruite. 0 = jamais, sauf si la recette vanilla utilisait ce type (une recette faite d'armes reçoit souvent des armes).
		}

		IngredientSurpriseChance: {
			Label: Chance d'ingrédient surprise (%)
			Tooltip: Chance qu'un ingrédient d'une recette reconstruite soit de n'importe quel type (tiré avec les poids du loot : armes, accessoires, potions...) au lieu des poids d'ingrédients. Son niveau reste celui de l'emplacement ; sa valeur doit seulement tenir dans le plafond de valeur de la recette.
		}

		IngredientCountSpread: {
			Label: Écart du nombre d'ingrédients
			Tooltip: Chaque recette est reconstruite avec à peu près autant d'ingrédients que la recette vanilla : au plus ce nombre en plus ou en moins (le même nombre, un de plus ou un de moins sont les plus fréquents). 0 = toujours le nombre vanilla.
		}

		IngredientMax: {
			Label: Nombre maximal d'ingrédients par recette
			Tooltip: Une recette reconstruite n'a jamais plus d'ingrédients que cela (les ingrédients qui ne peuvent pas être remplacés, comme les objets de boss, sont gardés quand même).
		}

		RecipesForUncraftable: {
			Label: Recettes pour les objets non fabricables
			Tooltip: Les objets qu'aucune recette ne fabrique (murs, blocs obtenus seulement en les cassant, meubles trouvés dans le monde, objets de style, teintures, nourriture, matériaux) reçoivent une recette aléatoire sur une station aléatoire. Elle n'est faisable qu'à partir du palier où l'objet serait trouvé, jamais avant. L'équipement, les munitions, les potions, les minerais, les stations, les invocations de boss et les sacs n'en reçoivent jamais.
		}

		IngredientStackCap: {
			Label: Quantité maximale d'un ingrédient
			Tooltip: Les quantités sont choisies pour que les ingrédients valent à peu près autant que ceux de la recette vanilla, jusqu'à cette limite par ingrédient.
		}

		IngredientReusePenalty: {
			Label: Pénalité de réutilisation
			Tooltip: Fait apparaître les mêmes matériaux dans moins de recettes : un matériau déjà utilisé par n recettes est tiré avec son poids divisé par (1 + cette valeur x n), les matériaux courants tolérant plus d'usages. 0 = aucune pénalité.
		}

		RandomizeStations: {
			Label: Randomiser les stations de craft
			Tooltip: Les recettes peuvent demander une autre station de même niveau ou inférieur. Les recettes à la main restent à la main, celles de progression gardent la leur.
		}

		StationKeepChance: {
			Label: Station conservée (%)
			Tooltip: Chance qu'une recette garde sa propre station.
		}

		RandomizeShimmer: {
			Label: Randomiser les transmutations du Shimmer
			Tooltip: Chaque transformation du Shimmer donne un autre objet de même catégorie et de même tier. Le décraft n'est pas concerné.
		}
	}

	EnemySwapMode: {
		Tooltip: ""

		PerType: {
			Label: Par type
			Tooltip: ""
		}

		PerSpawn: {
			Label: À chaque apparition
			Tooltip: ""
		}

		ByBiome: {
			Label: Par biome
			Tooltip: ""
		}
	}

	EnemiesConfig: {
		DisplayName: 6. Ennemis et boss

		Headers: {
			Bosses: Boss
			Enemies: Ennemis normaux
			EnemySwap: Ennemis aléatoires
			GiantsAndMinis: Géants et minis
			LootBonus: Loot des ennemis forts
			DamageLimit: Limite de dégâts
		}

		RandomizeBossHealth: {
			Label: Randomiser la vie des boss
			Tooltip: La vie normale de chaque boss est multipliée par une valeur aléatoire entre le minimum et le maximum, fixe pour le monde. Les bonus expert et maître s'ajoutent par-dessus.
		}

		BossHealthMin: {
			Label: Vie des boss : multiplicateur minimum
			Tooltip: 0.5 = moitié de la vie.
		}

		BossHealthMax: {
			Label: Vie des boss : multiplicateur maximum
			Tooltip: 3 = triple de la vie.
		}

		RandomizeBossDamage: {
			Label: Randomiser les dégâts des boss
			Tooltip: Les dégâts de contact et les projectiles de chaque boss sont multipliés par une valeur aléatoire fixe pour le monde.
		}

		BossDamageMin: {
			Label: Dégâts des boss : multiplicateur minimum
			Tooltip: ""
		}

		BossDamageMax: {
			Label: Dégâts des boss : multiplicateur maximum
			Tooltip: À garder bas : la défense est soustraite des dégâts, donc un petit multiplicateur fait déjà beaucoup plus mal.
		}

		BossStatExtremeness: {
			Label: Rareté des valeurs extrêmes (boss)
			Tooltip: 1 = toutes les valeurs de la plage sont aussi probables. Plus haut : les valeurs éloignées de la normale sont plus rares.
		}

		BossIndividualVariation: {
			Label: Variation des boss entre combats (%)
			Tooltip: Chaque combat de boss varie un peu autour des valeurs du boss dans ce monde.
		}

		BossGiantChance: {
			Label: Chance de boss géant (%)
			Tooltip: Chance qu'un boss soit géant (plus grand, beaucoup plus résistant). Certains boss peuvent se comporter bizarrement en géant.
		}

		RandomizeEnemyStats: {
			Label: Randomiser les ennemis normaux
			Tooltip: La vie, les dégâts, la défense et la taille de chaque type d'ennemi sont multipliés par des valeurs aléatoires fixes pour le monde.
		}

		EnemyHealthMin: {
			Label: Vie : multiplicateur minimum
			Tooltip: ""
		}

		EnemyHealthMax: {
			Label: Vie : multiplicateur maximum
			Tooltip: ""
		}

		EnemyDamageMin: {
			Label: Dégâts : multiplicateur minimum
			Tooltip: ""
		}

		EnemyDamageMax: {
			Label: Dégâts : multiplicateur maximum
			Tooltip: À garder bas : la défense est soustraite des dégâts, donc un petit multiplicateur fait déjà beaucoup plus mal. Les gros multiplicateurs, c'est pour la vie.
		}

		EnemyDefenseMin: {
			Label: Défense : multiplicateur minimum
			Tooltip: ""
		}

		EnemyDefenseMax: {
			Label: Défense : multiplicateur maximum
			Tooltip: ""
		}

		EnemyScaleMin: {
			Label: Taille : multiplicateur minimum
			Tooltip: Change aussi la hitbox. De grandes valeurs peuvent bloquer les ennemis.
		}

		EnemyScaleMax: {
			Label: Taille : multiplicateur maximum
			Tooltip: ""
		}

		StatExtremeness: {
			Label: Rareté des valeurs extrêmes
			Tooltip: 1 = toutes les valeurs des plages sont aussi probables. Plus haut : les valeurs éloignées de la normale sont plus rares, mais restent possibles.
		}

		ScaleFollowsLife: {
			Label: La taille suit la vie
			Tooltip: 0 = taille et vie indépendantes. 1 = les types d'ennemis plus résistants sont plus grands.
		}

		IndividualVariation: {
			Label: Variation entre individus (%)
			Tooltip: Chaque ennemi varie un peu autour des valeurs de son type dans ce monde (vie, dégâts, défense, taille).
		}

		GiantChance: {
			Label: Chance de géant (%)
			Tooltip: Chance qu'un ennemi soit géant : bien plus grand, résistant et dangereux, avec un meilleur loot.
		}

		GiantSizeMin: {
			Label: Taille des géants (minimum)
			Tooltip: Multiplicateur de taille des géants. Les grandes tailles sont plus rares.
		}

		GiantSizeMax: {
			Label: Taille des géants (maximum)
			Tooltip: ""
		}

		MiniChance: {
			Label: Chance de mini (%)
			Tooltip: Chance qu'un ennemi soit mini : minuscule, plus faible, difficile à toucher.
		}

		MiniSizeMin: {
			Label: Taille des minis (minimum)
			Tooltip: Multiplicateur de taille des minis. Les plus petites tailles sont plus rares.
		}

		MiniSizeMax: {
			Label: Taille des minis (maximum)
			Tooltip: ""
		}

		MaxGiantPixels: {
			Label: Plus grand géant (pixels)
			Tooltip: Un géant n'est jamais plus large ou haut que ça (une tuile fait 16 pixels), pour qu'il puisse encore se déplacer.
		}

		LootBonusStrength: {
			Label: Force du bonus de loot
			Tooltip: Les ennemis plus forts (vie x dégâts x dégâts au-dessus de la normale : les dégâts comptent double, la défense en est soustraite) ont de meilleures chances de drops bonus. 0 = pas de bonus.
		}

		LootBonusCap: {
			Label: Plafond du bonus de loot
			Tooltip: Plus grand multiplicateur des chances de drops bonus.
		}

		GiantBonusDrop: {
			Label: Les géants donnent un objet de plus
			Tooltip: Un géant donne toujours un objet utile de plus (équipement ou station d'artisanat), d'un palier au-dessus de son niveau dans la limite de progression, avec cinq fois plus de chances d'être un jackpot.
		}

		MiniBonusDrop: {
			Label: Les minis donnent un objet de plus
			Tooltip: Un mini (petit, rapide et dangereux) donne toujours un objet aléatoire de plus, de son niveau, avec deux fois plus de chances d'être un jackpot.
		}

		RandomizeEnemySpawns: {
			Label: Randomiser les apparitions d'ennemis
			Tooltip: Les ennemis qui apparaissent naturellement deviennent un autre ennemi du même tier qui se déplace pareil (sol, vol, eau). Les boss et les vers ne changent jamais.
		}

		EnemySwapMode: {
			Label: Mode de remplacement
			Tooltip: Par biome : les ennemis naturels sont redistribués entre les biomes ; chacun garde son nombre de lieux d'apparition, les ennemis rares restent rares et ceux du mode difficile arrivent avec lui. Par type : chaque ennemi est toujours remplacé par le même autre ennemi dans un monde. À chaque apparition : chaque apparition tire un nouveau remplaçant.
		}

		EnemySwapChance: {
			Label: Chance de remplacement (%)
			Tooltip: Modes par type et à chaque apparition : part des ennemis (par type) ou des apparitions (à chaque apparition) qui sont remplacés. Le mode par biome utilise plutôt la chance de garder l'ennemi d'origine.
		}

		BiomeVanillaChance: {
			Label: Chance de garder l'ennemi d'origine (%)
			Tooltip: Par biome : chance qu'une apparition reste l'ennemi prévu par le jeu de base. 0 = toutes les apparitions suivent la nouvelle liste du biome.
		}

		BiomeExtraEnemies: {
			Label: Invités inattendus (%)
			Tooltip: Par biome : part des lieux d'apparition partagés avec des ennemis qui ne viennent d'habitude qu'avec un événement (Lune de sang, éclipse, gobelins, pirates...) : là, une apparition sur deux est cet invité, l'ennemi habituel du lieu y vient donc deux fois moins. Aucun ennemi ne perd de lieu.
		}

		SwapCritters: {
			Label: Remplacer aussi les critters
			Tooltip: Les critters ne sont remplacés que par d'autres critters.
		}

		SwapEventEnemies: {
			Label: Remplacer aussi les ennemis d'invasion
			Tooltip: Armée gobeline, pirates, Légion du givre, Martiens, Armée de l'Ancien.
		}

		SwapModdedEnemies: {
			Label: Inclure les ennemis des autres mods
			Tooltip: Leurs ennemis sont redistribués aussi, y compris dans leurs propres biomes.
		}

		MaxDamageMultiplier: {
			Label: Dégâts totaux : multiplicateur maximum
			Tooltip: Le randomizer ne multiplie jamais les dégâts d'un ennemi, d'un boss ou d'une partie de boss par plus que ça au total (type, variation, géant et puissance adaptative cumulés ; le bonus expert et maître s'ajoute toujours). Les dégâts sont bien plus forts que la vie dans Terraria : la défense en est soustraite, donc x10 de dégâts transforme un coup à 1 dégât en one-shot.
		}
	}

	ExtrasConfig: {
		DisplayName: 7. Extras

		Headers: {
			StartingKit: Kit de départ
			TownNpcs: PNJ de ville
			Hints: Indices
		}

		StartingKit: {
			Label: Kit de départ aléatoire
			Tooltip: Donne à chaque personnage un kit aléatoire la première fois qu'il entre dans un monde.
		}

		KitWeapons: {
			Label: Armes
			Tooltip: ""
		}

		KitAccessories: {
			Label: Accessoires
			Tooltip: ""
		}

		KitPotions: {
			Label: Potions
			Tooltip: ""
		}

		KitTools: {
			Label: Outils
			Tooltip: ""
		}

		MagicStorageKit: {
			Label: Kit Magic Storage
			Tooltip: Si Magic Storage est chargé : donne à chaque personnage, une fois par monde, un Storage Heart, 4 Storage Units, un Crafting Access ainsi que le Portable Access et le Portable Crafting Access de base.
		}

		RandomizeTownNpcOrder: {
			Label: Ordre d'arrivée aléatoire des PNJ
			Tooltip: Chaque condition d'arrivée amène un autre PNJ : le Sorcier peut venir avec 50 pièces d'argent, le Marchand après Skeletron... Fixe pour le monde. Les PNJ à sauver (Gobelin, Mécanicienne...) ne sont pas concernés.
		}

		HintBasePrice: {
			Label: Prix de base d'un indice (or)
			Tooltip: Prix en pièces d'or du premier niveau d'indice sur un objet de palier 0, acheté au Guide (bouton Indice). Chaque palier ajoute 1,5 fois ce prix, chaque niveau coûte 3 fois le précédent : 2 or donne 2, 6, 18 et 54 or pour un établi. 0 : gratuit.
		}
	}

	ClientConfig: {
		DisplayName: 8. Client

		Headers: {
			Debug: Outils de débogage
			Messages: Messages
			Display: Affichage
		}

		DebugTools: {
			Label: Outils de débogage (touche K)
			Tooltip: Outils de test pour le développement du mod : le panneau K (état du randomizer, inspecteur, triche, tests automatiques) et les commandes /rdebug et /rtest. Ils dévoilent tout le tirage : désactivés par défaut.
		}

		AdaptiveMessages: {
			Label: Messages de puissance adaptative
			Tooltip: Te prévient dans le chat quand ton équipement renforce les ennemis, ou quand le monde l'a rattrapé.
		}

		ShowWorldDrops: {
			Label: Afficher les drops de ce monde
			Tooltip: Avec le style de loot Permutation : le bestiaire et Recipe Browser montrent ce que les ennemis, les boss et les sacs de trésor lâchent dans ce monde (drops mélangés, drops en plus et garantis) au lieu des drops vanilla. Désactivé : ils montrent les drops vanilla.
		}
	}

	StationProtection: {
		AllStations: {
			Label: Toutes les stations
			Tooltip: ""
		}

		ProgressionOnly: {
			Label: Stations de progression seulement
			Tooltip: ""
		}

		None: {
			Label: Aucune
			Tooltip: ""
		}

		// Tooltip: ""
	}

	IngredientMode: {
