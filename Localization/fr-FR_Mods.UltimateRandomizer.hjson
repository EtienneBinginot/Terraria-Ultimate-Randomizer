		}

		EnemyDefenseMax: {
			Label: Défense : multiplicateur maximum
			Tooltip: ""
		}

		EnemyScaleMin: {
			Label: Taille : multiplicateur minimum
			Tooltip: "Change aussi la hitbox. De grandes valeurs peuvent bloquer les ennemis."
		}

		EnemyScaleMax: {
			Label: Taille : multiplicateur maximum
			Tooltip: ""
		}
	}

