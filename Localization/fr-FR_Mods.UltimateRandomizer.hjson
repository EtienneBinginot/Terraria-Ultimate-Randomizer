	CraftingConfig: {
		DisplayName: 5. Craft et Shimmer

		Headers: {
			Recipes: Recettes
			Shimmer: Shimmer
		}

		RandomizeRecipes: {
			Label: Randomiser les résultats des recettes
			Tooltip: Chaque recette donne un objet de même catégorie et de même tier que l'original. Les recettes redeviennent normales quand tu quittes le monde.
		}

		RecipeValueGuard: {
			Label: Garde-fou de valeur
			Tooltip: Un résultat peut valoir au maximum ce nombre de fois ses ingrédients. Empêche de transformer des ingrédients bon marché en fortune.
		}

		DisableDecraftOfRandomizedResults: {
			Label: Pas de décraft Shimmer des résultats aléatoires
			Tooltip: Empêche de dupliquer des objets en craftant un résultat aléatoire puis en le décraftant dans le Shimmer.
		}

		RecipeSurpriseChance: {
			Label: "Chance de surprise des recettes (%)"
			Tooltip: "Chance qu'une recette donne un objet de n'importe quelle catégorie (poids du loot) au lieu d'un objet du même type que le résultat d'origine."
		}

		IngredientWeights: {
			Label: "Poids des ingrédients"
			Tooltip: "Chance relative de chaque type d'objet quand un ingrédient de recette est remplacé. 0 = jamais."
		}

		RandomizeShimmer: {
			Label: Randomiser les transmutations du Shimmer
			Tooltip: Chaque transformation du Shimmer donne un autre objet de même catégorie et de même tier. Le décraft n'est pas concerné.
		}
	}

