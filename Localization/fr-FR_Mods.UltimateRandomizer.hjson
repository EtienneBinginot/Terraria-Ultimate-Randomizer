Chat.OldRandomizerEnabled: "[Ultimate Randomizer] tRandomizer est aussi activé : le loot est randomisé deux fois. N'active qu'un seul des deux randomizers dans Manage Mods."
Chat.StartingKit: "Ultimate Randomizer : tu as reçu un kit de départ aléatoire pour ce monde !"

Commands: {
	Seed: {
		Description: Affiche ou change la graine du randomizer de ce monde
		Show: Graine du randomizer de ce monde : {0}
		Changed: Graine changée en {0} : tout est randomisé à nouveau.
		NotAllowed: Seul l'hôte peut changer la graine, et seulement si la config l'autorise.
	}

	Debug: {
		Description: Informations de débogage du randomizer
		NotFound: Introuvable : {0}
		Item: "{0} : {1}, tier {2} ({3}), protégé : {4}, exclu : {5}, stack {6}-{7}"
		Npc: "{0} : tier {1} (utilisé pour les tirages : {2})"
		Tier: Tier débloqué : {0} ({1})
		PoolLogged: La répartition des objets a été écrite dans client.log.
		NoDrops: Cet ennemi ne donne rien dans ce monde.
	}

	Chests: {
		Description: "Randomise les coffres naturels d'un monde créé sans le mod"
		AlreadyDone: "Les coffres sont déjà randomisés dans ce monde."
		Warning: "Ceci randomise une fois tous les coffres naturels sans nom. Les coffres renommés sont ignorés, mais les coffres de joueur sans nom de style naturel peuvent être modifiés. Tape /rchests confirm pour continuer."
		Done: "{0} coffres randomisés."
	}
}

