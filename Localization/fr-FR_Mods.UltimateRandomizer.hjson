	EconomyConfig: {
		DisplayName: "4. Économie"
		Headers: {
			Stacks: Taille des stacks
		}

		StackCaps: {
			Label: Stack maximum par catégorie
			Tooltip: Quantité maximale donnée d'un coup. Le stack maximum propre à l'objet s'applique toujours.
		}

		StackMultiplier: {
			Label: Multiplicateur de stack
			Tooltip: Multiplie tous les maximums ci-dessus.
		}

		ValueBasedStacks: {
			Label: Garder la valeur des objets remplacés
			Tooltip: Quand un objet en remplace un autre, la quantité est ajustée pour que la valeur totale reste proche de l'original.
		}
	}

