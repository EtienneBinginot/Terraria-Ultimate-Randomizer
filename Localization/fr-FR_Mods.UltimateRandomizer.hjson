	EconomyConfig: {
		DisplayName: 4. Économie
		Headers: {
			Shops: Boutiques
			Stacks: Taille des stacks
		}

		RandomizeShops: {
			Label: Randomiser les boutiques
			Tooltip: "Chaque objet en vente est remplacé par un objet de même catégorie. Il garde les conditions d'apparition de l'objet d'origine."
		}

		PriceMultiplierMin: {
			Label: Multiplicateur de prix (minimum)
			Tooltip: "Prix = valeur de l'objet x un multiplicateur aléatoire. Jamais sous 1 : acheter puis revendre ne rapporte jamais d'argent."
		}

		PriceMultiplierMax: {
			Label: Multiplicateur de prix (maximum)
			Tooltip: ""
		}

		MinimumPrice: {
			Label: Prix minimum (pièces de cuivre)
			Tooltip: "100 cuivre = 1 argent."
		}

		NoDuplicatesInShop: {
			Label: Pas de doublons dans une boutique
			Tooltip: ""
		}

		ShopsFollowProgression: {
			Label: Les boutiques suivent la progression
			Tooltip: "Les boutiques vendent de meilleurs objets à mesure que tu bats les boss."
		}

		StackCaps: {
			Label: Stack maximum par catégorie
			Tooltip: Quantité maximale donnée d'un coup. Le stack maximum propre à l'objet s'applique toujours.
		}

		StackMultiplier: {
			Label: Multiplicateur de stack
			Tooltip: Multiplie tous les maximums ci-dessus.
		}

		ValueBasedStacks: {
			Label: Garder la valeur des objets remplacés
			Tooltip: Quand un objet en remplace un autre, la quantité est ajustée pour que la valeur totale reste proche de l'original.
		}
	}

