Keybinds: {
	Debug.DisplayName: Ouvrir le panneau de débogage du randomizer
	Journal.DisplayName: Ouvrir le codex du randomizer
}

Debug: {
	Title: Ultimate Randomizer - débogage
	NeedWorld: Charge d'abord un monde.
	SinglePlayerOnly: Cette action ne marche qu'en solo.
	TabOverview: Vue d'ensemble
	TabInspector: Inspecteur
	TabTools: Outils
	TabTests: Tests
	On: oui
	Off: non
	Seed: Graine
	Mode: Mode
	Network: Partie
	SinglePlayer: solo
	Multiplayer: multijoueur
	Tier: Tier débloqué
	Limit: Tier max autorisé
	Gating: Blocage
	Pool: Objets randomisables / protégés / exclus
	Snapshots: Tables de loot ennemis / sacs
	Findable: Trouvable dès le tier {0}, obtenable (avec craft) dès le tier {1}
	GuaranteedOn: Drop garanti de : {0}
	GuaranteedTag: (garanti)
	Individual: "{0} : vie x{1}, dégâts x{2}, défense x{3}, taille x{4} ; bonus de loot x{5}"
	Adaptive: Puissance adaptative : vie x{0}, dégâts x{1} (compris ci-dessus)
	Power: Puissance adaptative
	PowerStats: puissance {0}, écart {1} tiers : ennemis vie x{2} dégâts x{3}, boss vie x{4} dégâts x{5}
	KindNormal: Normal
	KindGiant: Géant
	KindMini: Mini
	Swaps: Remplacements
	SwapStats: "{0} repérés : {1} ennemis et {2} critters remplacés ; {3} non remplaçables, {4} gardés par le hasard, {5} sans remplaçant, {6} dans des lieux pas encore ouverts"
	Recipes: Recettes
	Shimmer: Shimmer
	Chests: Coffres
	SetTier: Régler la progression (boss vaincus) au tier :
	NewSeed: Nouvelle graine
	PoolTable: Objets par catégorie, tiers 0 à 9 :
	TierSet: Progression réglée sur {0}.
	SeedSet: Nouvelle graine : {0}.
	HoverItem: Objet sous la souris (ou en main)
	NoItem: Survole un objet ou tiens-en un.
	ItemInfo: Catégorie {0}, tier {1} ({2}), protégé {3}, exclu {4}, stack {5}-{6}, valeur {7}
	ShufflePartner: Partenaire du mélange garanti : {0}
	NearestNpc: PNJ le plus proche de la souris
	NoNpc: Aucun PNJ près de la souris.
	NpcTier: tier {0} (tirages : {1})
	Multipliers: Multiplicateurs : vie x{0}, dégâts x{1}, défense x{2}, taille x{3}
	Swappable: Peut être remplacé par les ennemis aléatoires.
	NotSwappable: Jamais remplacé par les ennemis aléatoires.
	Drops: Loot dans ce monde :
	NoDrops: Ne donne rien dans ce monde.
	ExtraTag: (en plus)
	ConditionTag: (conditions)
	Player: Joueur
	GodMode: Invincible
	SpawnRate: Apparitions
	SpawnRateNormal: normales
	SpawnRateNone: aucune
	SpawnRateHigh: beaucoup
	ToggleGodMode: Invincible oui/non
	CycleSpawnRate: Taux d'apparition
	GiveKit: Kit de test
	GiveEndgameKit: Kit de fin de jeu
	World: Monde
	Day: jour
	Night: nuit
	SpawnEnemies: Faire apparaître 5 ennemis
	KillHostiles: Tuer les ennemis à l'écran
	ToggleDay: Jour/nuit
	GiveBags: Tous les sacs de boss
	OpenJournal: Codex
	ToolsHelp: Astuce : onglet Inspecteur + souris sur un ennemi = son loot ; tue-le pour comparer. Les ennemis invoqués apparaissent comme des naturels (les ennemis aléatoires s'appliquent).
	RunTests: Lancer tous les tests
	TestsHelp: Lance tous les tests automatiques dans le monde actuel. Les résultats vont aussi dans client.log.
	TestSummary: "{0} réussis, {1} échoués, {2} ignorés"
}

Tests: {
	NoWorld: Monde chargé
	PoolBuilt: Liste d'objets construite, chaque catégorie principale a des objets
	Classification: Les objets connus sont bien classés
	Determinism: Les tirages sont déterministes et dépendent de la graine
	GatingRespected: Aucun objet au-dessus du tier autorisé (blocage par progression)
	NoProtectedRolled: Les objets protégés et exclus ne sont jamais donnés au hasard
	SameCategory: Les remplaçants gardent la catégorie
	ShuffleBijection: Mélange garanti : chaque objet obtenable est donné exactement une fois
	StackRules: Les tailles de stack sont valides
	PriceFloor: Les prix des boutiques ne sont jamais sous la valeur de l'objet
	DropRates: Les taux de drop sont valides
	TierFromRecipes: Les objets fabriqués prennent le tier de leur recette vanilla quand il est plus précoce que leur rareté (combinaisons du Tinkerer)
	StorageKitOnce: Le kit Magic Storage est donné une fois par monde, et de nouveau dans un autre monde
	SnapshotsCaptured: Les tables de loot d'origine ont été lues
	MobPlansValid: Toutes les tables de loot des ennemis sont valides
	LootAbundanceScales: L'abondance du butin multiplie les drops des ennemis, pas les drops garantis
	DropTableLength: Les ennemis ont de longues tables de loot (2 à 7 emplacements : environ 1,85 fois les anciens 1 à 4)
	JackpotUseful: Les jackpots sont toujours des objets utiles
	JackpotNotInEnemyDrops: Les jackpots ne comptent pas parmi les drops de l'ennemi
	JackpotRatesLower: Les jackpots sont un peu plus rares par défaut
	JackpotDropsMarked: Les drops au-delà de la limite sont marqués comme jackpots
	GiantBonusUseful: L'objet bonus d'un géant est utile, avec cinq fois plus de chances d'être un jackpot
	MiniBonusDrop: Les minis et les géants donnent un objet bonus, jamais les sbires de boss
	JackpotWorthScales: Les ennemis faibles ont une part des chances de jackpot qui suit leur vie (0,1 à 1)
	SpawnedEnemyNoExtraDrops: Les ennemis engendrés par un autre ennemi ne donnent ni drop en plus, ni drop garanti, ni jackpot
	CrittersNoJackpot: Les bestioles ne donnent jamais de jackpot
	BagNeverJackpot: Les sacs et caisses ouverts ne donnent jamais de jackpot
	JackpotTail: Chaque palier de plus d'un jackpot est bien plus rare, et seuls les jackpots dépassent la limite (mode difficile compris)
	HardmodeWall: Rien du mode difficile avant celui-ci sauf les jackpots et les planchers des boss, indices cohérents avec la limite
	RepickOnlyChangesFlagged: Le nouveau tirage ne remplace que les objets bannis ou trop avancés, tous les autres tirages sont inchangés
	RaisedTiers: Les objets fabriqués avec des matériaux du mode difficile attendent celui-ci, rien n'est abaissé
	BannedNeverRolled: Les objets créatifs et internes (tModLoader, Recipe Browser, objets créatifs des autres mods) ne sont jamais donnés
	ChestCap: Le contenu d'un coffre ne dépasse jamais son plafond, ni le mode difficile dans un coffre d'avant celui-ci
	ChestTameKeepsOpened: L'ajustement des coffres d'un monde en cours ne touche jamais un coffre ouvert ou un coffre jackpot
	JackpotChests: Les coffres jackpot sont choisis de la même façon à chaque fois parmi les coffres éligibles et contiennent des objets utiles au-dessus de leur plafond
	PlanDiff: Mesure à quel point le mur du mode difficile change le plan de ce monde (recettes, trouvabilité, butins garantis) par rapport aux anciennes règles (dans le journal) ; le butin final des ennemis et des sacs ne doit pas changer
	TierCoherence: Mesure, pour la refonte des recettes, les matériaux de chaque palier, les stations de progression, les recettes sans ingrédient du palier de leur résultat, les paliers relevés et la traîne des coffres jackpot (dans le journal)
	TierAudit: Liste dans TierAudit.tsv les objets vanilla dont le palier semble douteux (relevé par leurs sources, une source bien plus précoce, ou aucune source), et compte les objets bannis du plan des monstres (dans le journal)
	ItemTierDump: Écrit ItemTiers.tsv, une ligne par objet vanilla avec ses paliers, sa trouvabilité, les paliers de recette vanilla et planifiés, les ingrédients planifiés et les données de minage (lecture seule)
	WorldChestTrueTiers: Les objets des coffres générés avec le monde sont trouvables dès le tier de leur coffre (vrai tier abaissé, jamais relevé)
	ShopDump: Écrit Shops.tsv, chaque article des boutiques vanilla à chaque palier débloqué avec son remplaçant (tirage aléatoire), puis les emplacements ajoutés qui vendent les objets exclusifs aux boutiques de ce monde, avec prix, conditions et alertes (trop tôt, autre catégorie, objet vendu seulement en boutique perdu), et ShopOnly.tsv, qui indique quel marchand vend chaque objet exclusif aux boutiques de ce monde et à partir de quel palier (lecture seule)
	WorldExport: Écrit dans Export/ les fichiers .tsv des objets, recettes, butins, sacs, boutiques, coffres, sources du monde et trouvabilité, plus un README, pour un audit de cohérence hors jeu (lecture seule)
	ShopsNotTooEarly: Les remplaçants des boutiques ne dépassent jamais le palier débloqué + 1 + la variation de palier des boutiques, et aucun emplacement ajouté n'apparaît avant le palier de déblocage de son objet
	ShopOnlyItemsKept: Les objets que seules les boutiques vendent en vanilla (câblage, Clentaminateur et solutions, graines de biome, bombes, rangement...) restent obtenables dans ce monde : trouvés ou fabriqués à n'importe quel palier, ou vendus dans un emplacement ajouté chez un marchand fiable (une vente tardive est seulement signalée dans le journal)
	ShopOnlyPlacement: Chaque objet exclusif aux boutiques de ce monde (vendu par un article tiré au hasard, et ni trouvé ni fabriqué nulle part dans ce monde, à aucun palier) a exactement un emplacement ajouté chez un marchand fiable (arrivée connue, ni le Père Noël, ni la Princesse, ni un marchand de passage), visible dès son palier de déblocage, sans dépasser la place libre d'une boutique tant que d'autres en ont, jamais tiré une seconde fois dans cette boutique, identique pour une même graine (les marchands tardifs sont signalés dans le journal)
	ShopOnlySlots: Chaque boutique avec des emplacements ajoutés, remplie comme le jeu la remplit en ce moment puis complétée comme en jeu, propose chaque objet exclusif débloqué à son prix, et seul un emplacement tiré au hasard cède sa place quand la boutique est pleine
	ShopNoDuplicates: Sans doublons dans les boutiques, aucune boutique ne vend deux fois le même remplaçant
	ModdedRecipesRandomized: Avec Magic Storage, ses recettes sont reconstruites avec un ingrédient clé de leur palier, et les paliers de ses améliorations de stockage suivent leurs lingots dans l'ordre
	ModdedItemsInPool: Les objets de Magic Storage peuvent être donnés au hasard ; ceux des mods utilitaires (tModLoader, Recipe Browser) et les objets créatifs jamais
	ModdedDropsPermuted: Les butins des ennemis et boss des autres mods sont permutés avec ceux de tout le monde, à leur palier estimé
	ModdedStationsTiered: Les stations des autres mods prennent le palier de leur objet, ne sont données qu'aux recettes de leur palier, et les thématiques sont garanties quand elles ne sont pas protégées
	TierFloorsHold: Les planchers de tier audités tiennent : matériaux de progression stricte sans tolérance, le Suiveur compté comme le Cerveau, ennemis tardifs et butins globaux, coffres à clé, niveaux de minage, baisse par les sources fiables
	GuaranteeScalesWithPlayers: Les stations garanties sont partagées entre joueurs, les stations aléatoires plus rares
	LockedDropsRedistributed: Les chances des butins verrouillés passent aux butins aléatoires débloqués de l'ennemi, plafonnées à 100 %
	LockedVanillaDropRemoved: Un butin d'origine remplacé encore verrouillé par la progression ne tombe pas ; un butin débloqué tombe comme prévu
	DropPermutationConserves: La permutation des drops ne perd et ne duplique rien : chaque drop vanilla permuté tombe toujours d'un ennemi
	DropPermutationMoves: Les drops permutés restent dans leur groupe de palier et la plupart passent à un autre ennemi
	DropPermutationAccess: Les drops réservés au mode expert, au mode maître ou à une graine spéciale ne vont qu'à des emplacements avec les mêmes restrictions
	DropPermutationRuntime: Les règles de drop de chaque ennemi suivent vraiment la permutation : les drops vanilla réduits au silence tombent ailleurs, rien ne tombe en double, les variantes gardent leurs propres drops, les ennemis sans drop en reçoivent un
	DropPermutationStable: Retirer un drop de la permutation ne change le contenu que de très peu d'autres drops
	DropPermutationSurprise: Les surprises de la permutation remplacent à peu près la part réglée des drops mélangés, jamais un matériau ni l'exemplaire que garde chaque objet (sauf blocs, créatures et minerais)
	BossPermutationConserves: La permutation des boss ne perd et ne double rien : chaque drop de boss et contenu de sac mélangé est toujours dans un boss ou un sac
	BossBagMatchesBoss: Chaque sac de trésor contient les drops mélangés du mode normal de son boss, avec leur chance et leur quantité dans le sac d'où ils viennent
	BossPermutationTiers: Les drops de boss ne passent qu'entre boss du même groupe de tiers, avec les mêmes restrictions
	WorldDropsReported: Avec la permutation, le bestiaire et les rapports de drops montrent les drops du monde : ce qu'un ennemi lâche maintenant, ni ses règles vanilla réduites au silence, ni les entrées encore verrouillées par la progression
	BossRuntime: Les règles de drop des boss et des sacs suivent vraiment la permutation : les drops coupés sont tirés quelque part, rien ne tombe deux fois
	PermutationConservation: Chaque entrée de drop vanilla des ennemis, des boss et des sacs de boss se trouve exactement une fois quelque part, à sa place ou déplacée
	PermutedConditions: Les drops déplacés n'ont que des conditions possibles : ni saisonnière ni de premier kill, les conditions propres à un objet le suivent
	EaterOfWorldsParts: Le corps et la queue du Dévoreur des mondes tirent dans la table de la tête, avec le plancher du boss
	BossGroupsMerge: Les petits tiers de boss consécutifs se regroupent d'abord, et le butin du Seigneur de la Lune reste avec les derniers boss
	CodexShowsLocked: Interface du codex : les butins verrouillés sont grisés avec le boss qui les débloque, sans chance
	ProtectedDropsKept: Les drops protégés, pièces, sacs et améliorations sont conservés
	NoMinionFarms: Les minions de boss et les PNJ n'ont pas de drops aléatoires
	EventItemsKept: Objets de l'Armée de l'Ancien et segments de boss préservés
	SwapSurvivesVariantSetDefaults: Les variantes d'ennemis (Pinky, zombies) sont bien remplacées
	CritterSwapLive: Les critters sont vraiment remplacés, dans le même habitat
	CritterPoolSafe: Aucun critter doré, Chrysope prismatique, Ver truffe ou critter de lave ne peut en remplacer un autre
	CritterHabitat: Les critters aquatiques, volants et terrestres restent dans leur habitat
	SwapStatsCount: Les apparitions naturelles sont comptées, celles des statues ignorées
	NpcTiersNormalStats: Les tiers des ennemis viennent des stats du mode normal, quel que soit le monde joué avant un rechargement
	CodexRecordsLoot: Le codex enregistre les ennemis tués et chaque objet lâché par un ennemi courant qui a un drop assuré (un slime à défaut)
	CodexRecipesFromGuide: Le Guide fait découvrir les recettes qui utilisent l'objet et celles qui le donnent
	CodexSaveLoad: Le codex est sauvegardé et rechargé avec le monde sans rien perdre
	CodexSyncRoundTrip: Les découvertes du codex passent le format réseau intactes (différences et synchro complète)
	CodexUiBuilds: Interface du codex : chaque onglet et chaque fiche d'objet, d'ennemi et d'arbre d'artisanat se construit
	CodexHidesUndiscovered: Interface du codex : recettes, ennemis, objets et sacs non découverts restent cachés
	CodexManyItemsBounded: Interface du codex : avec 3000 objets et 300 ennemis, seules les lignes visibles sont construites
	CodexTextsResolved: Interface du codex : aucune clé de texte brute n'est affichée
	CodexShowsChances: Interface du codex : le butin découvert affiche sa chance prévue, les biomes la part des apparitions
	CodexShowsConditions: Le codex indique quand un ennemi se rencontre (le jour, la nuit) sur ses pages de biome, d'ennemi et d'objet
	BiomeSlotsReachable: Par biome : chaque lieu d'apparition d'un ennemi qui en a plusieurs peut être atteint
	NegativeNetIdSwap: Le remplacement par une couleur de slime (Pinky) fonctionne et garde le type Slime bleu
	EvilSlotsShared: Par biome : dans un monde à un seul mal, les ennemis des lieux du mal absent apparaissent dans le mal présent (20 graines)
	BiomeRedistributionComplete: Par biome : chaque ennemi naturel garde son nombre de lieux d'apparition, dans sa classe et sa paire de tiers, jamais plus d'un tier au-dessus du lieu (20 graines)
	BiomeSlotsRespectDaylight: Par biome : aucun ennemi qui fuit ou meurt au soleil (Gnome) dans un lieu de surface de jour
	BiomeExtrasShare: Par biome : 8 % des lieux d'apparition sont partagés avec des ennemis d'événement
	CriticalHostsInForest: Par biome : les gardiens des premières stations sont des ennemis croisés dès la première heure (Forêt, grottes ou désert)
	SurpriseZero: Avec 0 % de surprise, les objets remplacés gardent leur catégorie
	SurpriseHundred: Avec 100 % de surprise, les catégories suivent les poids du loot
	SurpriseGatedAndProtected: Les surprises respectent la progression et les objets protégés
	WeightTablesSeparated: Les poids du loot favorisent l'équipement, ceux des ingrédients jamais
	TierWindowVariety: Les tirages de début de partie donnent beaucoup d'objets différents
	OreMappingBijective: Chaque minerai du monde existe encore, comme drop d'un seul autre minerai du monde ; les minerais absents restent eux-mêmes, et le choix d'une paire hardmode ne change aucun minerai d'un autre palier ; un pour un même quand les deux minerais d'une paire sont présents
	TreeShakeReplacement: Les arbres secoués donnent des objets aléatoires et gardent les glands
	HerbReplacementTable: Chaque herbe a un ensemble fixe de remplaçants valides
	ExtractinatorRules: L'Extractinator garde les pièces et échange les minerais contre des minerais
	AnglerRewardsValid: Les récompenses du Pêcheur sont des objets valides, pièces conservées
	TreeCritterSwap: Les critters qui tombent des arbres sont aussi remplacés
	PacingExpected: 15 à 25 pièces d'équipement aléatoires par heure en début de partie (réglages par défaut ; valeur écrite dans client.log)
	PacingSimulation: La simulation du rythme est stable et régulière
	PacingVariety: Au moins 10 pièces d'équipement différentes par heure en début de partie
	JackpotPacing: Peu de jackpots dans une heure de début de partie (nombre par heure dans le journal)
	DropFrequency: La plupart des kills donnent quelque chose (au moins 0,6 objet par kill ; valeur écrite dans client.log)
	WorkBenchPacing: L'établi se fabrique à la main dès le début, et son gardien seul en donne un en moins d'une heure en moyenne (valeur écrite dans client.log)
	BasicStationsUnprotected: Les stations de base (établi, fourneau, enclume...) sont confiées au randomizer
	ProgressionStationsProtected: Les stations de progression et thématiques sont protégées, sauf si la protection des stations vaut Aucune
	ProgressionStationsGuaranteed: Les stations de progression (par leur gardien) et les invocations de boss non protégées tombent d'ennemis fréquents de leur palier (1 % ou plus)
	ProtectionsRemoved: Les matériaux de progression, miroirs, invocations et outils de progression sont randomisés, restent trouvables à leur palier, et aucune permutation ne place un verrou de progression avant son palier
	AbsentEvilBoss: Le boss maléfique absent du monde ne participe pas à la permutation des boss et ne compte pas comme source
	TempleKeyOutsideTemple: La clé du temple n'est jamais garantie dans le temple ni sur des ennemis qu'on ne croise que là
	ConfigMigration: Anciens réglages sauvegardés : une ancienne liste par défaut d'objets protégés est retirée, les choix du joueur sont gardés
	UpgradesOutOfPools: Les améliorations de vie et de mana ne sont jamais tirées au sort, garanties ni utilisées comme ingrédients, et les drops les gardent
	BasicStationsFindable: Chaque station de base se trouve dès le début (son gardien), jamais dans les pots
	GuaranteedReachability: Chaque objet garanti est porté par des ennemis naturels de son tier, ou par les boss de progression de son tier
	GuaranteedBiomeHosts: Chaque objet garanti est porté par plusieurs ennemis d'un même biome, avec la même chance sur chacun (une station : son seul gardien)
	GuaranteedSeveralSeeds: Chaque objet garanti obtient les ennemis d'un biome avec d'autres graines
	GuaranteedBiomesSpread: Les objets garantis d'un tier sont répartis sur plusieurs biomes
	GuaranteedBiomesVaried: Les premières stations tombent dans au moins cinq biomes proches différents, jamais dans un biome lointain
	GuaranteedFindTime: Chaque invocation et outil garanti tombe en environ 90 ennemis tués dans son biome (les gardiens des stations sont journalisés)
	GuaranteedDayAndNight: Une invocation ou un outil garanti dont le biome se visite de jour et de nuit a au moins deux ennemis à chaque moment
	GuaranteedHostLoad: Aucun ennemi ne porte plus de quatre objets garantis (cinq quand son biome n'a pas d'autre choix), ni ne donne trop d'objets garantis par victime
	GuaranteedReachable: Les objets garantis ne sont jamais dans un biome avant qu'on puisse y chasser (donjon, Enfer, temple, ciel), ni dans un cimetière ou une météorite
	HintSortedByProgress: Les indices sont triés par avancement, en deux onglets
	HintFoundUnlocks: L'indice d'un objet trouvé est entièrement connu, gratuitement
	HintClickOpensCodex: Cliquer sur un indice ouvre la bonne page du codex
	HintTreeComplete: Un indice de recette donne la source de chaque ingrédient et station, jusqu'aux matières premières
	HintTreeDeterministic: Les arbres des indices de recette sont les mêmes après reconstruction
	HintTabsSplit: Les indices du Guide sont répartis entre artisanat et boss
	HintTreeKeepsOtherHints: Un arbre d'indice cache les stations et invocations des autres indices tant qu'ils ne sont pas connus
	HintConditionsShown: Les indices et arbres de fabrication disent quand une source fonctionne : heure, météo ou événement, conditions de butin et de recette, autels pour les minerais du hardmode
	HintSummonTiers: Les invocations de boss sont proposées quand leur boss est la prochaine étape (cellule énergétique après Plantera, œil mécanique en mode difficile)
	HintLockedShown: Les indices pour plus tard sont listés en grisé avec le moment où ils viendront, et ne sont jamais vendus
	StationHints: Le dernier indice sur une station donne à la fois sa recette (ingrédients et stations) et son gardien
	GuaranteedHostsNotEvents: Les drops garantis ne sont jamais sur des ennemis d'invasion, de lune, saisonniers ou météo
	GuaranteedDeterminism: Les sources garanties sont identiques après reconstruction
	FindabilityDeterminism: La trouvabilité des objets est identique après reconstruction
	WorldMaterialsFindable: Bois, pierre, gemmes et premiers minerais se trouvent dès le début
	BagContentFindable: Le contenu d'un sac ne compte comme trouvable que si le sac peut être obtenu (jamais les sacs saisonniers, les sacs de trésor seulement en mode expert)
	CrateAccessWorld: Les caisses que le monde ne peut pas donner (autre mal, caisse sacrée avant le hardmode) ne comptent pas comme source
	HardmodeOresOfWorld: Les minerais des paires hardmode comptent toujours comme trouvables et ne deviennent jamais de nouveaux ingrédients
	AltarDecisionKeepsCaches: Le choix d'un minerai hardmode par un autel ne change ni les sources garanties ni la trouvabilité
	PotOnlyUnfound: Les pots ne donnent que des objets garantis que personne n'a encore trouvés
	GuaranteesNotBelowTier: Aucun objet garanti n'arrive avant son tier (Manipulateur antique et Sceau céleste pas avant le Cultiste lunatique)
	StationsOneGuardian: Chaque station d'artisanat a un seul gardien, un ennemi courant de son palier, et ne vient jamais des pots ni des coffres
	IngredientReplacementsFindable: Les nouveaux ingrédients s'obtiennent (trouvés ou fabriqués) au palier pour lequel leur recette a été reconstruite
	RecipesDoable: Au moins 85 % des recettes randomisées sont faisables à leur niveau
	AvailabilityConsistent: La disponibilité prévue des objets correspond à un recalcul indépendant sur les recettes appliquées
	NoSelfIngredient: Aucune recette n'utilise son propre résultat
	ResultNotInGroup: Aucune recette randomisée ne donne un objet accepté par son propre groupe d'ingrédients
	IngredientValueCoherent: Les recettes reconstruites gardent à peu près la valeur des ingrédients vanilla
	ProtectedIngredientsKept: Les ingrédients protégés ne sont jamais remplacés
	RecipeGroupsSane: Chaque groupe de recette (n'importe quel bois, lingot de fer...) garde son ingrédient
	RecipePlanDeterminism: Ingrédients et stations identiques après reconstruction
	UntouchedRecipesIntact: Les recettes protégées gardent leurs ingrédients et stations
	DecraftSafeWithIngredients: Le décraft au Shimmer ne rend jamais des ingrédients plus précieux
	VanillaModeGuaranteed: En mode ingrédients vanilla, chaque ingrédient manquant est placé sur des ennemis
	StationDag: Aucune station de craft n'a besoin d'elle-même pour être fabriquée, directement ou via d'autres stations
	StationTierRespected: Les recettes ne demandent jamais de station au-dessus de leur niveau, ni de station thématique
	HandCraftKept: Les recettes à la main restent à la main
	StationsVaried: Une bonne part des recettes a changé de station
	AppliedResultsMatchPlan: Les recettes donnent leur résultat vanilla ou celui de leur partenaire d'échange, comme prévu, et la disponibilité correspond aux recettes en jeu
	StationPlanFromOriginals: Le choix des stations ne dépend que des recettes d'origine, pas de celles déjà randomisées
	RealCrafting: Le menu d'artisanat propose une recette avec ses nouveaux ingrédients, et plus avec les anciens
	PickaxePerMiningLevel: Chaque niveau de minage a une pioche au tier de ses minerais (fabriquée, trouvée ou garantie)
	RecipeRandomizationShare: Presque toutes les recettes vanilla changent (95 %), peu échangent leur résultat (environ la chance d'échange) ; les raisons sont journalisées
	RecipeEveryItemKept: Chaque objet fait par une recette vanilla reste fabricable, et rien de ce qu'on obtient en vanilla n'est perdu (Zénith)
	RecipeNoCycles: Aucun objet n'est fabriqué à partir de lui-même par un nouvel ingrédient, directement ou via d'autres recettes
	RecipeKeyed: Chaque recette reconstruite au-dessus du tier 0 a une clé et n'est pas faisable avant son tier
	RecipeSwapsShare: Environ la chance d'échange des recettes échangent leur résultat, par paires du même tier, surtout de types différents
	RecipeSwapCancelClean: Une paire d'échange annulée laisse les candidats exactement comme avant, et ses recettes redonnent leur propre résultat
	ZenithWeapons: Le Zénith garde des armes parmi ses ingrédients
	IngredientReuse: La pénalité de réutilisation répartit les matériaux sur plus de recettes
	CraftedValueFromIngredients: Un objet fabriqué avec une recette randomisée se revend au plus au prix de ses ingrédients, même après sauvegarde, réseau, division et empilement
	ShimmerNoMoneyLoop: Un objet fabriqué à bas prix ne donne jamais plus d'argent qu'il n'en valait en passant dans le Shimmer
	ShimmerLiveNoMoneyLoop: Un vrai passage dans le Shimmer d'objets fabriqués à bas prix ne rend jamais plus de valeur qu'il n'en a consommé
	ProtectedRecipesDoable: Les recettes des stations de progression et des objets protégés sont faisables à leur niveau
	RecipeKeyIngredient: Les recettes randomisées ne sont pas faisables avant le tier de leur résultat (ingrédient clé)
	RecipeNoStationTwins: Une même recette (résultat et ingrédients) n'apparaît jamais sur deux stations différentes
	UpgradeRecipes: Chaque amélioration de vie ou de mana a sa propre recette, faisable dès son tier, avec un ingrédient clé et des ingrédients valant au moins l'amélioration
	HouseItemsObtainable: La porte, la plateforme et la torche sont des cibles d'indices, et leurs recettes changent mais restent fabricables dès le début (ingrédients de palier 0, station de base)
	RecipesRebuilt: Au moins 90 % des recettes aux ingrédients remplaçables reçoivent de nouveaux ingrédients
	RecipeIngredientCount: Une recette reconstruite a le nombre d'ingrédients vanilla, à l'écart réglé près, sans dépasser le maximum réglé
	RecipeIngredientTiers: Une recette reconstruite n'a aucun ingrédient au-dessus de son palier, et la plupart en ont un exactement de son palier
	RecipeIngredientsAcyclic: Chaque ingrédient fabriqué d'une recette reconstruite est donné par une recette planifiée avant elle
	RecipeIngredientUseCaps: Aucun matériau n'est ingrédient de plus de recettes reconstruites que sa limite d'usage
	RecipeExamples: Journalise 10 recettes reconstruites (dont le Zénith et l'armure de chlorophyte), réellement changées
	UncraftableRecipesValid: Les objets qu'aucune recette ne fabrique reçoivent une recette active, faisable à partir de leur palier et jamais avant, qui ne se décompose jamais au miroitement ; journalise des exemples
	UncraftableRecipesOff: Réglage désactivé (planificateur appelé avec des paramètres explicites) : aucune recette coquille n'est planifiée et les autres recettes sont planifiées à l'identique
	UncraftableNoSpecials: Les recettes coquilles gardent leur objet (une amélioration seulement la sienne), ne sont jamais échangées ni désactivées comme copies
	UncraftablePricedByIngredients: Les recettes coquilles actives comptent comme randomisées : ce qu'elles fabriquent se vend au prix de ses ingrédients, pas à son prix d'origine
	RecipePickaxeMineable: Aucune recette reconstruite de pioche ou de foreuse ne reçoit un nouvel ingrédient dont le minage exige une puissance de pioche au moins égale à la sienne
	RecipeNotBeforeItsTier: Aucune recette reconstruite ou échangée n'est faisable avant le palier de l'objet qu'elle donne (son palier, ou son vrai palier s'il est plus tard) : pas de pioche en chlorophyte en début de mode difficile
	RecipeValueSane: Les recettes planifiées demandent des quantités raisonnables (le plafond de pile, ou trois fois une quantité vanilla) et les recettes reconstruites valent entre la moitié et le double de leur recette vanilla (un objet de valeur nulle compte sa propre recette) : pas 9999 murs en rubis pour un cristal de mana, pas de fragment de nébuleuse gardé pour un objet bon marché échangé
	ProtectedRecipesGated: Un résultat protégé dont les ingrédients sont reconstruits attend le palier débloqué de son vrai palier comme les autres : ni clé de nuit ni clé de lumière avant le mode difficile
	PickaxeIngredientsBelowLevel: Une recette de pioche ou de foreuse ne reçoit jamais de minerai ni de lingot (ni rien qui en soit fait) dont le minage exige sa propre puissance de pioche ou plus : pas de pioche en orichalque faite de lingots de chlorophyte
	StationsCraftable: Chaque station d'artisanat a une recette refaite avec des matériaux trouvés, faisable à son palier sans son gardien ; l'établi à la main dès le début
	BellCurveShape: Les stats des ennemis suivent une cloche : surtout normales, quelques % loin de la normale
	BellCurveBounds: Les stats tirées restent toujours dans leur plage
	ExtremenessEffect: Le réglage de rareté rend les valeurs extrêmes plus rares
	GiantMiniFrequency: Géants et minis apparaissent aussi souvent que réglé
	GiantMiniBounds: Les tailles des géants et minis restent dans leur plage
	GiantHitboxCap: Les géants ne dépassent jamais la taille maximale autorisée
	IndividualSyncRoundTrip: Les stats individuelles (géant, mini...) arrivent intactes chez les clients en multijoueur
	ClientIndividualLife: Les géants et les minis ont la bonne vie maximale chez les clients en multijoueur, sans écraser leur vie synchronisée
	NoGiantMinions: Les minions de boss ne sont jamais géants ni minis et ne donnent jamais le drop bonus des géants
	TransformRerollsIndividual: Les ennemis remplacés reçoivent leurs propres stats individuelles
	VariantGetsIndividual: Un ennemi changé en variante (Pinky...) garde ses propres stats individuelles et sa proportion de vie
	TransformKeepsIndividual: Une transformation vanilla garde les stats individuelles de l'ennemi (pas de géant qui clignote) et sa proportion de vie
	StatCacheBossFlag: Les multiplicateurs d'un boss ne dépendent pas d'une lecture antérieure du même type comme non-boss
	LootBonusCap: Le bonus de loot augmente avec la force et reste sous son plafond
	LootBonusApplied: Les ennemis plus forts reçoivent un bonus de loot
	DamageCapRespected: Les multiplicateurs de dégâts des ennemis restent sous le plafond total
	AdaptivePowerMeasured: La puissance du joueur vient de la meilleure arme, de l'armure portée et des 3 meilleurs accessoires
	AdaptiveFormula: Les multiplicateurs adaptatifs grandissent avec l'écart, sont plafonnés et jamais sous x1
	AdaptiveAppliedAtSpawn: Les ennemis reçoivent les multiplicateurs adaptatifs à leur apparition
	AdaptiveBossParts: Les parties de boss sont renforcées comme leur boss
	AdaptiveNotCompounded: Un ennemi transformé garde ses multiplicateurs adaptatifs sans les cumuler
	BagPlansValid: Tous les contenus de sacs sont valides
	BagsKeepCoins: Les sacs de boss gardent leurs pièces
	CrittersDrop: Les critters reçoivent leur part du petit drop fréquent
	WildTail: La queue de folie donne la part prévue au-delà de la limite, plus rare à chaque palier
	PlansIgnoreWild: Les plans, la trouvabilité et les garanties ne dépendent pas de la queue de folie
	RecipesSafe: Recettes : pas d'ingrédient identique au résultat, garde-fou respecté
	DecraftSafe: Le décraft au Shimmer ne peut pas dupliquer d'objets
	ShimmerCoherent: Les transformations du Shimmer gardent catégorie et valeur
	ShopSimulation: Boutique simulée : pas de doublons, prix justes, cases spéciales intactes
	EnemySwapPool: Ennemis aléatoires : ni morceaux de boss, ni minions, ni ennemis d'événement
	EnemySwapDaylight: Ennemis aléatoires : rien qui fuit le jour, de jour
	TownOrderPermutation: L'ordre des PNJ est une permutation valide
	EnemyStatRanges: Les multiplicateurs des boss restent dans les limites
	ConfigTexts: Chaque réglage a un texte
	OtherTexts: Chaque message a un texte
	ConfigRanges: Les réglages sont cohérents
	DebugToolsDefaultOff: Les outils de débogage sont désactivés par défaut
	CacheSignatureScope: Sauvegarder un réglage de stats d'ennemis garde la trouvabilité et le plan des recettes ; les réglages de butin et du pool d'échanges les recalculent
	CacheSignatureCovers: Chaque réglage d'apparition lu par les plans (mode d'échange, extras par biome, chances d'échange) et la montée avec la progression recalculent les caches du monde
	ConfigResetDefaults: Réglages : le bouton de réinitialisation remet chaque valeur par défaut, sur toutes les pages
	HintFactsTrue: Les indices disent ce que prévoient les planificateurs : l'hôte porte l'objet, la recette le fabrique
	HintPriceScales: Le prix des indices suit la formule et monte avec le niveau et le palier
	HintPurchaseFlow: Acheter un indice prend les pièces, monte son niveau, et est refusé sans assez de pièces
	HintSyncRoundTrip: Les niveaux d'indice survivent au format réseau du codex, à la sauvegarde et aux vérifications du serveur
	HintTextsResolved: Chaque phrase d'indice est une vraie phrase dans cette langue
	HintSourceFrequent: Les indices de créature mènent à des ennemis fréquents (5 % d'un biome ou plus, ensemble pour un objet garanti) avec 1 % de chances ou plus
	HintTargetsHaveSource: Chaque station et invocation garantie a un indice de créature ou de recette, jamais une source rare de secours
	HintBiomeEveryLevel: Les niveaux 2 à 4 d'un indice de créature nomment son meilleur biome
	HintRevealDiscovers: Le dernier niveau d'un indice révèle ses ennemis dans le codex (page, butin, biome), sauvegardé et synchronisé
	HintHostsNamed: L'indice d'un objet garanti nomme chaque ennemi de son biome qui le porte, avec la chance sur chacun
	PlannedShareSums: Les parts d'apparition prévues de chaque biome font 100 %, les ennemis rares en ont moins
}

